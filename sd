-- DROP BRAINROT (jump drop method from MWP DUELS): launch up for 0.22s
-- then snap back down to the ground
-- ════════════════════════════════════════════════════════
local DROP_ASCEND_DURATION = 0.22
local DROP_ASCEND_SPEED = 160
local dropActive = false
local dropConn = nil
local function dropBrainrot()
    if dropActive then
        return
    end
    local char = C.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not root then
        return
    end
    dropActive = true
    local t0 = tick()
    if dropConn then
        dropConn:Disconnect()
    end
    dropConn = game:GetService("RunService").Heartbeat:Connect(function() if _G.SDRX_KILL_pub then return end 
        local c2 = C.Character
        local r2 = c2 and c2:FindFirstChild("HumanoidRootPart")
        if not r2 or not dropActive then
            if dropConn then dropConn:Disconnect(); dropConn = nil end
            dropActive = false
            return
        end
        if tick() - t0 >= DROP_ASCEND_DURATION then
            if dropConn then dropConn:Disconnect(); dropConn = nil end
            pcall(function()
                local rp = RaycastParams.new()
                rp.FilterDescendantsInstances = { c2 }
                rp.FilterType = Enum.RaycastFilterType.Exclude
                local rr = workspace:Raycast(r2.Position, Vector3.new(0, -3000, 0), rp)
                if rr then
                    local hum = c2:FindFirstChildOfClass("Humanoid")
                    local off = ((hum and hum.HipHeight) or 2) + (r2.Size.Y / 2)
                    r2.CFrame = CFrame.new(r2.Position.X, rr.Position.Y + off, r2.Position.Z)
                    r2.AssemblyLinearVelocity = Vector3.zero
                end
            end)
            dropActive = false
            return
        end
        local lv = r2.AssemblyLinearVelocity
        r2.AssemblyLinearVelocity = Vector3.new(lv.X, DROP_ASCEND_SPEED, lv.Z)
    end)
end
