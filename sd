-- SAMMYDAWG EXTRAS MANAGER
-- Runs the hub, SammyDawg Tp (semi) and Pub Method as swappable modes.
-- Starting a method freezes + hides the hub; destroying it brings the hub back.
-- ============================================================================
local SDRX = {}
_G.SDRX = SDRX
do
    local Players  = game:GetService("Players")
    local UIS      = game:GetService("UserInputService")
    local RunSvc   = game:GetService("RunService")
    local LP       = Players.LocalPlayer
    local realTask, realInstance = task, Instance
    local baseEnv  = (getgenv and getgenv()) or _G

    local TRACK = {}
    for _, c in ipairs({"ScreenGui","Highlight","BillboardGui","SurfaceGui","Folder","Part","WedgePart","MeshPart",
        "Beam","Trail","Attachment","BodyVelocity","BodyPosition","BodyGyro","LinearVelocity","AlignPosition",
        "AlignOrientation","Sound"}) do TRACK[c] = true end
    local TOGGLE = { ScreenGui = true, BillboardGui = true, SurfaceGui = true, Highlight = true, Beam = true }

    local groups = {}
    local function newGroup(name)
        local g = { name = name, paused = false, killed = false, disabled = {},
            insts = {}, state = {}, draws = {}, drawState = {} }   -- strong on purpose: Roblox wrappers get GC'd, which silently dropped entries
        groups[name] = g
        return g
    end

    local function makeEnv(g)
        local function hold()
            if g.killed then
                pcall(realTask.cancel, coroutine.running())
                while true do realTask.wait(3600) end   -- park silently (no error spam)
            end
            while g.paused do realTask.wait(0.25) end
        end
        local tp = setmetatable({
            wait = function(t) local r = realTask.wait(t); hold(); return r end,
            delay = function(t, f, ...)
                local a = table.pack(...)
                return realTask.delay(t, function() hold(); f(table.unpack(a, 1, a.n)) end)
            end,
        }, { __index = realTask })
        local ins = setmetatable({
            new = function(c, p)
                local o = realInstance.new(c, p)
                if TRACK[c] then
                    g.insts[o] = os.clock()
                    if c == "ScreenGui" then pcall(function() o.ResetOnSpawn = false end) end   -- survive death/respawn
                end
                return o
            end,
        }, { __index = realInstance })
        local env = { task = tp, Instance = ins }
        if rawget(baseEnv, "Drawing") or (type(Drawing) == "table") then
            local realDrawing = rawget(baseEnv, "Drawing") or Drawing
            env.Drawing = setmetatable({
                new = function(t)
                    local o = realDrawing.new(t)
                    g.draws[o] = true
                    return o
                end,
            }, { __index = realDrawing })
        end
        if g.name ~= "main" then
            env.warn = function(...)
                local parts = {}
                for i = 1, select("#", ...) do parts[#parts + 1] = tostring((select(i, ...))) end
                pcall(function() SDRX.toast(table.concat(parts, " ")) end)
                return warn(...)
            end
        end
        env.wait = function(t) return tp.wait(t) end
        return setmetatable(env, { __index = baseEnv })
    end

    local function chunkOf(fn)
        if type(fn) ~= "function" then return nil end
        local ok, s = pcall(function() return debug.info(fn, "s") end)
        if ok and type(s) == "string" then return s end
        ok, s = pcall(function() return debug.getinfo(fn, "S").source end)
        return ok and s or nil
    end

    local function signals()
        local list = { UIS.InputBegan, UIS.InputEnded, UIS.InputChanged, UIS.JumpRequest,
            RunSvc.Heartbeat, RunSvc.RenderStepped, RunSvc.Stepped,
            Players.PlayerAdded, Players.PlayerRemoving, LP.CharacterAdded, LP.CharacterRemoving,
            workspace.ChildAdded, workspace.DescendantAdded, workspace.DescendantRemoving }
        pcall(function()
            local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                for _, s in ipairs({ hum.Died, hum.StateChanged, hum.Running, hum.HealthChanged }) do list[#list + 1] = s end
            end
        end)
        pcall(function() list[#list + 1] = game:GetService("ProximityPromptService").PromptTriggered end)
        pcall(function() list[#list + 1] = game:GetService("ProximityPromptService").PromptShown end)
        return list
    end

    -- connections created by the chunk tagged `tag` (needs getconnections)
    local function myConns(tag)
        local out = {}
        if not getconnections then return out end
        for _, sig in ipairs(signals()) do
            local ok, conns = pcall(getconnections, sig)
            if ok and type(conns) == "table" then
                for _, c in ipairs(conns) do
                    local ch = chunkOf(c.Function)
                    if ch and ch:find(tag, 1, true) then out[#out + 1] = c end
                end
            end
        end
        return out
    end

    -- hide = pull every tracked root instance out of the world (parent -> nil); show = put it back
    local function setEnabledOf(g, on)
        if on then
            for o, was in pairs(g.drawState) do pcall(function() o.Visible = was end) end
            g.drawState = {}
        else
            for o in pairs(g.draws) do
                if g.drawState[o] == nil then
                    local ok, cur = pcall(function() return o.Visible end)
                    if ok then g.drawState[o] = cur end
                end
                pcall(function() o.Visible = false end)
            end
        end
        if on then
            for inst, par in pairs(g.state) do
                pcall(function() if par and par.Parent then inst.Parent = par end end)
            end
            g.state = {}
        else
            local roots = {}
            for inst in pairs(g.insts) do
                local ok, par = pcall(function() return inst.Parent end)
                if ok and par and not g.insts[par] then roots[inst] = par end
            end
            for inst, par in pairs(roots) do
                g.state[inst] = par
                pcall(function() inst.Parent = nil end)
            end
        end
    end

    -- ---- hub freeze / thaw -------------------------------------------------
    local function suspendMain()
        local g = groups.main
        if not g or g.paused then return end
        g.paused = true
        SDRX.mainPaused = true
        pcall(setEnabledOf, g, false)
        local ok, list = pcall(myConns, "SDR_MAIN")
        g.disabled = ok and list or {}
        for _, c in ipairs(g.disabled) do pcall(function() c:Disable() end) end
        -- keep the hub hidden: it may try to re-parent its own windows from loops we can't gate
        realTask.spawn(function()
            while g.paused do
                realTask.wait(0.5)
                if g.paused then pcall(setEnabledOf, g, false) end
            end
        end)
    end
    local function restoreMain()
        local g = groups.main
        if not g or not g.paused then return end
        g.paused = false
        SDRX.mainPaused = false
        for _, c in ipairs(g.disabled) do pcall(function() c:Enable() end) end
        g.disabled = {}
        pcall(setEnabledOf, g, true)
    end

    -- ---- back button -------------------------------------------------------
    local backGui
    local function hideBack() if backGui then pcall(function() backGui:Destroy() end); backGui = nil end end
    local function showBack(label)
        hideBack()
        local parent = (gethui and gethui()) or game:GetService("CoreGui")
        local sg = realInstance.new("ScreenGui")
        sg.Name = "SDRXBack"; sg.ResetOnSpawn = false; sg.IgnoreGuiInset = true; sg.DisplayOrder = 1000001
