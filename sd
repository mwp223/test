        local mod = _getSyncMod()
        if mod then best, n, where = _apiChans(mod) end
        if not best or n == 0 then _nextApi = os.clock() + (tonumber(_G.SDRSyncApiGap) or 0.5) end
    end

    if not best or n == 0 then best, n, where = _gcChans() end

    if (not best or n == 0) and _attempts2 <= 400 and _G.SDRAllowUpvalueProbe then
        local mod = _getSyncMod()
