                        local b = c:FindFirstChild("SammyPlayerESPLabel"); if b then b:Destroy() end
                    end
                end
            end
            task.wait(0.6)
        end
    end)

    -- ---------------- brainrot ESP ----------------
    task.spawn(function()
        local folder
        local anchors = {}
        while true do
            if flags.brainrot then
                if not (folder and folder.Parent) then
                    folder = Instance.new("Folder")
                    folder.Name = "SammyBrainrotESP"
