    local function killMethod(kind)
        local g = groups[kind]
        if not g then return end
        g.killed = true
        _G["SDRX_KILL_" .. kind] = true
        if kind == "tpblock" then pcall(function() if _G.Formega_Script_Purge then _G.Formega_Script_Purge() end end) end
        local ok, list = pcall(myConns, "SDR_" .. string.upper(kind))
        for _, c in ipairs(ok and list or {}) do
            pcall(function() c:Disconnect() end)
            pcall(function() c:Disable() end)
        end
        for inst in pairs(g.insts) do pcall(function() inst:Destroy() end) end
        for o in pairs(g.draws) do pcall(function() o:Remove() end); pcall(function() o.Visible = false end) end
        -- sweep: anything new that appeared in the gui containers while the method ran
        local function sweep(delayed)
            -- a delayed sweep must never touch a method that was started after this one was destroyed
            if delayed and SDRX.active then return end
            local mainG = groups.main
            local actG = SDRX.active and groups[SDRX.active]
            local pg = LP:FindFirstChildOfClass("PlayerGui")
            for _, host in ipairs(guiHosts()) do
                for _, ch in ipairs(host:GetChildren()) do
                    local known = g.snap[host] and g.snap[host][ch]
                    local isMain = (mainG and (mainG.insts[ch] or mainG.state[ch])) or (actG and actG.insts[ch])
                    if ch:IsA("ScreenGui") and not known and not isMain and ch.Name ~= "SDRXBack"
                        and (host ~= pg or ch.ResetOnSpawn == false or ch.Name:find("MWP", 1, true)) then
                        pcall(function() ch:Destroy() end)
                    end
                end
            end
        end
        local function purge()
            for inst in pairs(g.insts) do pcall(function() inst:Destroy() end) end
            pcall(sweep, true)
        end
        pcall(sweep)
        realTask.delay(1, purge)
        realTask.delay(3, purge)
        realTask.delay(6, purge)
        realTask.spawn(function() restoreWorldSnap(g.world) end)
        pcall(function() _G.speedBoostEnabled = false end)
        groups[kind] = nil
        SDRX.active = nil
        hideBack()
    end

    -- drop long-dead instances so the strong tables don't grow forever
    realTask.spawn(function()
        while true do
            realTask.wait(10)
            local now = os.clock()
            for _, g in pairs(groups) do
                if not g.paused then
                    for inst, t in pairs(g.insts) do
                        local ok, par = pcall(function() return inst.Parent end)
                        if (not ok or par == nil) and now - t > 15 then g.insts[inst] = nil end
                    end
                end
            end
        end
    end)

    SDRX.active = nil
    function SDRX.start(kind)
        local src = _G.SDRX_SRC and _G.SDRX_SRC[kind]
        if type(src) ~= "string" or SDRX.active == kind then return false end
        if SDRX.active then killMethod(SDRX.active) else suspendMain() end
        _G["SDRX_KILL_" .. kind] = false
        local f, err = loadstring(src, "=SDR_" .. string.upper(kind))
        if not f then
            restoreMain()
            warn("[SammyDawg] could not load " .. kind .. ": " .. tostring(err))
            return false
        end
        local g = newGroup(kind)
        g.snap = {}
        for _, host in ipairs(guiHosts()) do
            g.snap[host] = {}
            for _, ch in ipairs(host:GetChildren()) do g.snap[host][ch] = true end
        end
        if setfenv then pcall(setfenv, f, makeEnv(g)) end
        SDRX.active = kind
        showBack(kind == "semi" and "SEMI TP" or (kind == "tpblock" and "TP BLOCK" or "PUB METHOD"))
        realTask.spawn(function()
            realTask.spawn(function()
                local okS, snap = pcall(takeWorldSnap)
                if okS then g.world = snap end
            end)
            local ok, e = pcall(f)
            if not ok then warn("[SammyDawg] " .. kind .. " error: " .. tostring(e)) end
        end)
        -- if the method closes/destroys its own UI, tear it down and go back to the hub
        realTask.spawn(function()
            local seen, dead = false, 0
            while SDRX.active == kind and not g.killed do
                realTask.wait(1)
                local alive = false
                for inst in pairs(g.insts) do
                    if inst.ClassName == "ScreenGui" and inst.Parent then alive = true; break end
                end
                if alive then seen = true; dead = 0
                elseif seen then
                    dead = dead + 1   -- needs 3 empty checks in a row, so a respawn blip never counts
                    if dead >= 10 then SDRX.stop(); return end
                end
            end
        end)
        fire()
        return true
    end
    function SDRX.stop()
        if SDRX.active then
            local k = SDRX.active
            if not pcall(killMethod, k) then SDRX.active = nil; groups[k] = nil; pcall(hideBack) end
        end
        restoreMain()
        fire()
    end
    function SDRX.isActive(kind) return SDRX.active == kind end

    -- run the hub itself under the same wrapper so it can be frozen
    SDRX.runMain = function(src)
        local g = newGroup("main")
        local f, err = loadstring(src, "=SDR_MAIN")
        if not f then error("SDR main failed to load: " .. tostring(err)) end
        if setfenv then pcall(setfenv, f, makeEnv(g)) end
        return f()
    end
end

