                local wpDir = Vector3.new(WAYPOINT.X - rootPos.X, 0, WAYPOINT.Z - rootPos.Z)
                local wpDist = wpDir.Magnitude
                if wpDist <= BASE_STOP_DIST then
                    waypointReached = true
