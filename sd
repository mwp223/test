    end

    local WHITE = Color3.fromRGB(245, 245, 248)
    local MUTC = {
        Gold = Color3.fromRGB(255, 205, 60), Diamond = Color3.fromRGB(110, 220, 255), Rainbow = Color3.fromRGB(255, 130, 200),
        Lava = Color3.fromRGB(255, 110, 50), Candy = Color3.fromRGB(255, 120, 190), Galaxy = Color3.fromRGB(150, 110, 255),
        Cursed = Color3.fromRGB(190, 60, 60), Divine = Color3.fromRGB(255, 240, 160), Bloodrot = Color3.fromRGB(200, 40, 60),
        Radioactive = Color3.fromRGB(120, 255, 90), Cyber = Color3.fromRGB(70, 230, 220), Crystal = Color3.fromRGB(170, 220, 255),
        Phantom = Color3.fromRGB(170, 150, 220), YinYang = Color3.fromRGB(220, 220, 220),
    }
    local function fmtGen(n)
        n = tonumber(n) or 0
        if n >= 1e9 then return ("$%.2fB/s"):format(n / 1e9)
        elseif n >= 1e6 then return ("$%.1fM/s"):format(n / 1e6)
        elseif n >= 1e3 then return ("$%.1fK/s"):format(n / 1e3) end
        return ("$%d/s"):format(n)
    end
    local function label(parent, adornee, text, color, size, offY)
