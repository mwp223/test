    -- Sammydawg ragdoll sync: while ragdolled, keep the grab pending and start the hold so it
    -- completes right as the ragdoll ends, then pick up with no extra dwell.
    local function _ragRem()
        local et = tonumber(LP:GetAttribute("RagdollEndTime")) or 0
        if et <= 0 then return 0 end
        return (et - workspace:GetServerTimeNow()) + (tonumber(_G.SDRRagdollPad) or 0.1)
    end
    local function _ragPreWait(prompt, holdDur)
        if _G.SDRRagdollHold == false then return end
        local t0, cap = tick(), tonumber(_G.SDRRagdollHoldMax) or 12
        while tick() - t0 < cap do
            local rem = _ragRem()
            if rem <= holdDur + (tonumber(_G.SDRRagdollLead) or 0.2) then return end
            if not (prompt and prompt.Parent) then return end
            RunService.Heartbeat:Wait()
        end
    end
    local function executeStealAsync(prompt, petName, restoreMax, pet)
        if _holdBusy() then
            return false
        end
        local data = InternalStealCache[prompt]
        if not data or not data.ready then return false end
        data.ready = false
        _stealHoldStart = tick()
        _stealHoldActive = true
        pcall(function() prompt.MaxActivationDistance = math.huge end)
        showStealBar(petName, 0)
        if _G.SDRStealQuick == true then
            task.spawn(function()
                _ragPreWait(prompt, STEAL_HOLD_DURATION)
                for _, fn in ipairs(data.holdCallbacks) do task.spawn(fn) end
                pcall(function()
                    local st = prompt:GetAttribute("State")
                    if st ~= nil and st ~= "Steal" then _stealBegin() end
                end)
                _G.SDRStealSrvEnd = workspace:GetServerTimeNow() + STEAL_HOLD_DURATION
                local _barConn
                pcall(function()
                    _barConn = RunService.RenderStepped:Connect(function() if _G.SDRX and _G.SDRX.mainPaused then return end 
                        local rem = _G.SDRStealSrvEnd and (_G.SDRStealSrvEnd - workspace:GetServerTimeNow()) or 0
                        if rem <= 0 then
                            setStealBarPct(1)
                        else
                            setStealBarPct(1 - rem / STEAL_HOLD_DURATION)
                        end
                    end)
                end)
                local remaining = _G.SDRStealSrvEnd - workspace:GetServerTimeNow()
                if remaining > 0 then task.wait(remaining) end
                if _G.SDRTPSync ~= false then
                    local _tg0 = tick()
                    while isTeleporting and prompt and prompt.Parent and tick() - _tg0 < (tonumber(_G.SDRTPHoldMax) or 8) do
                        RunService.Heartbeat:Wait()
                    end
                end
                if _G.SDRRagdollHold ~= false then
                    local _rc0 = tick()
                    while _ragRem() > 0 and prompt and prompt.Parent and tick() - _rc0 < (tonumber(_G.SDRRagdollHoldMax) or 12) do
                        RunService.Heartbeat:Wait()
                    end
                end
                if _barConn then pcall(function() _barConn:Disconnect() end) end
                if prompt and prompt.Parent then
                    for _, fn in ipairs(data.triggerCallbacks) do task.spawn(fn) end
                else
                    _armedPet, _armLostSince = nil, 0
                end
                for _, fn in ipairs(data.holdEndCallbacks) do task.spawn(fn) end
                task.wait(0.05)
                _stealHoldActive = false
                _G.SDRStealSrvEnd = nil
                if restoreMax ~= nil then
                    pcall(function()
                        if prompt and prompt.Parent then prompt.MaxActivationDistance = restoreMax end
                    end)
                end
                data.ready = true
                hideStealBar()
            end)
            return true
        end
        task.spawn(function()
            local GRAB_MIN = STEAL_HOLD_DURATION
            local GRAB_MAX = tonumber(_G.SDRStealHoldMax) or STEAL_HOLD_MAX
            pcall(function()
                local hd = prompt.HoldDuration
                if type(hd) == "number" and hd > 0 and hd + 0.05 > GRAB_MIN then
                    GRAB_MIN = hd + 0.05
                end
            end)
            if GRAB_MAX < GRAB_MIN then GRAB_MAX = GRAB_MIN end
            _ragPreWait(prompt, GRAB_MIN)
            _stealHoldStart = tick()
            for _, fn in ipairs(data.holdCallbacks) do task.spawn(fn) end
            local _ppSeen, _ppKind, _charSeen, _hrpSeen = nil, 0, nil, nil
            local function _grabRange()
                local char = LP.Character
                if not char then return true end
                if char ~= _charSeen then
                    _charSeen = char
                    _hrpSeen = char:FindFirstChild("HumanoidRootPart")
                end
                local hrp = _hrpSeen
                if not hrp or hrp.Parent ~= char then
                    hrp = char:FindFirstChild("HumanoidRootPart")
                    _hrpSeen = hrp
                    if not hrp then return true end
                end
                local pp = prompt.Parent
                if not pp then return true end
                if pp ~= _ppSeen then
                    _ppSeen = pp
                    _ppKind = (pp:IsA("Attachment") and 1) or (pp:IsA("BasePart") and 2) or 0
                end
                local pos
                if _ppKind == 1 then pos = pp.WorldPosition
                elseif _ppKind == 2 then pos = pp.Position
                else return true end
                return (hrp.Position - pos).Magnitude <= (tonumber(_G.SDRStealGrabDist) or 12)
            end
            local DWELL = tonumber(_G.SDRStealDwell) or 0.22
            local readyAt = nil
            local _gone = false
            local _ragT0, _rehold, _wasRag = tick(), false, false
            local _tpGateT0, _tpWas = tick(), false
            local _barConn
            pcall(function()
                _barConn = RunService.RenderStepped:Connect(function() if _G.SDRX and _G.SDRX.mainPaused then return end 
                    local el = tick() - _stealHoldStart
                    if not (prompt and prompt.Parent and prompt:IsDescendantOf(workspace)) then return end
                    if el < GRAB_MIN then
                        setStealBarPct(el / GRAB_MIN)
                    else
                        local span = GRAB_MAX - GRAB_MIN
                        local left = GRAB_MAX - el
                        setStealBarPct(span > 0 and (1 - left / span) or 1)
                    end
                end)
            end)
            while true do
                local el = tick() - _stealHoldStart
                if not (prompt and prompt.Parent and prompt:IsDescendantOf(workspace)) then _gone = true break end
                -- TP gate (Sammydawg): while the teleport is still running, keep holding but never commit
                if _G.SDRTPSync ~= false and isTeleporting and (tick() - _tpGateT0) < (tonumber(_G.SDRTPHoldMax) or 8) then
                    _tpWas = true
                    readyAt = nil
                    if el >= (tonumber(_G.SDRSrvHoldMax) or 2.3) then
                        -- keep the server-side hold fresh so it is ready the moment we arrive
                        for _, fn in ipairs(data.holdCallbacks) do task.spawn(fn) end
                        _stealHoldStart = tick()
                    end
                    RunService.Heartbeat:Wait()
                    continue
                elseif _tpWas then
                    -- teleport finished: commit as soon as the hold is satisfied and we are in range
                    _tpWas = false
                    DWELL = 0
                    readyAt = tick()
                end
                if _G.SDRRagdollHold ~= false then
                    local rr = _ragRem()
                    if rr > 0 and (tick() - _ragT0) < (tonumber(_G.SDRRagdollHoldMax) or 12) then
                        _wasRag = true
                        if not _rehold and rr <= GRAB_MIN + (tonumber(_G.SDRRagdollLead) or 0.2) then
                            _rehold = true
                            for _, fn in ipairs(data.holdCallbacks) do task.spawn(fn) end
                            _stealHoldStart = tick()
                        end
                        readyAt = nil
                        RunService.Heartbeat:Wait()
                        continue
                    elseif _wasRag then
                        _wasRag = false
                        DWELL = 0
                        readyAt = tick()
                    end
                end
                if el >= GRAB_MAX then break end
                if _grabRange() then
                    if not readyAt then readyAt = tick() end
                    if el >= GRAB_MIN and (tick() - readyAt) >= DWELL then break end
                else
                    readyAt = nil
                end
                RunService.Heartbeat:Wait()
            end
            if _barConn then pcall(function() _barConn:Disconnect() end) end
            setStealBarPct(0)
            if not _gone and prompt and prompt.Parent then
                for _, fn in ipairs(data.triggerCallbacks) do task.spawn(fn) end
            elseif _gone then
                _armedPet, _armLostSince = nil, 0
            end
            for _, fn in ipairs(data.holdEndCallbacks) do task.spawn(fn) end
            task.wait(0.05)
            _stealHoldActive = false
            if restoreMax ~= nil then
                pcall(function()
                    if prompt and prompt.Parent then prompt.MaxActivationDistance = restoreMax end
                end)
            end
            data.ready = true
            hideStealBar()
        end)
        return true
    end

    local function timeUntilCanSteal()
        if LP:GetAttribute("Stealing") or LP:GetAttribute("IsTrading")
            or LP:GetAttribute("IsDuelSelecting") or LP:GetAttribute("Web") then
            return -1
        end
        local ragdoll = LP:GetAttribute("RagdollEndTime")
        if ragdoll then
            local r = ragdoll - workspace:GetServerTimeNow()
            if r > 0 then return r end
        end
        return 0
    end

    local stealOn = (_G.SDRStealMode ~= nil)
    local _emptyScans = 0
    local function _fireSteal(pet)
        if not pet then return false end
        if _holdBusy() then  return false end
        local _fhrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local _fd = (_fhrp and pet.position) and (pet.position - _fhrp.Position).Magnitude or nil
        local _judge = (_fd ~= nil) and (_fd <= _prox() + 2) or false
        local _cd = _holdDur() + (tonumber(_G.SDRStealCycleGap) or 0)
        


        local prompt = findStealPrompt(pet)
        if not prompt or not prompt.Parent then
            
            return false
        end
        local oldMax
        pcall(function() oldMax = prompt.MaxActivationDistance end)
        pcall(function() prompt.MaxActivationDistance = math.huge end)
        buildStealCallbacks(prompt)
        if InternalStealCache[prompt] then
            if executeStealAsync(prompt, pet.name, oldMax, pet) then
                _G.SDRLastFire = os.clock()
                _verifyFire(pet, "prompt", _judge)
                return true
            end

            if oldMax ~= nil then pcall(function() prompt.MaxActivationDistance = oldMax end) end
            return false
        elseif fireproximityprompt then
            pcall(function() prompt.MaxActivationDistance = math.huge end)
            showStealBar(pet.name, 1)
            pcall(function() fireproximityprompt(prompt) end)
            _G.SDRLastFire = os.clock()
            _verifyFire(pet, "prompt", _judge)

            task.delay(0.4, hideStealBar)
            pcall(function() if oldMax ~= nil then prompt.MaxActivationDistance = oldMax end end)
            return true
        end
        
        return false
    end
    _G.SDRFireStealNow = function(pet) return _fireSteal(pet) end
    _G.SDRPrepSteal = function(pet)
        pcall(function()
            local pr = findStealPrompt(pet)
            if pr and pr.Parent then buildStealCallbacks(pr) end
        end)
    end
    _G.SDRHoldDur = _holdDur
    _G.SDRFireSteal = _fireSteal
    local function _stealTick()
        _G.SDRTickN = (_G.SDRTickN or 0) + 1
        stealOn = (_G.SDRStealMode ~= nil)
        if not stealOn then  return end
        if _G.SDRInstantOn == true then return end   -- SDR: instant snipe owns grabbing
        local now = os.clock()
        local _lockUid = _G.SDRStealTargetUID
        local _lockChanged = (type(_lockUid) == "string" and _lockUid ~= "" and _lockUid ~= _lastPickUid)
        local _needPick = (not _stealTarget) or _lockChanged or (now - _lastTargetPick) >= (tonumber(_G.SDRRepickGap) or 0.2)
        if _armedPet then
            local _lp = _armLivePos(_armedPet)
            if _lp then
                _armedPet.position = _lp
                _armLostSince = 0
            elseif _armLostSince == 0 then
                _armLostSince = now
            elseif now - _armLostSince > (tonumber(_G.SDRArmLostGrace) or 1.0) then
                _armedPet, _armLostSince = nil, 0
            end
            if _armedPet and (now - _armCheckAt) >= (tonumber(_G.SDRArmCheckGap) or 0.3) then
                _armCheckAt = now
                local okL, listed = pcall(_petListed, _armedPet.plot, _armedPet.slot)
                if okL and not listed then
                    
                    _armedPet, _armLostSince = nil, 0
                end
            end
            if _armedPet and _G.SDRStealMode ~= "nearest" then
                _stealTarget = _armedPet
                if type(_armedPet.name) == "string" then _currentTargetName = _armedPet.name end
                _needPick = false
            end
        end
        local _scanGap = (_emptyScans >= 3) and (tonumber(_G.SDRStealIdleGap) or 0.2) or 0.01
        if not LP:GetAttribute("Stealing") and _needPick and (now - _autoLastScan) >= _scanGap then
            _autoLastScan = now
            _lastTargetPick = now
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local pets = _scanCached(now, 0.05)
                local ok = pets ~= nil
                if ok and pets and #pets > 0 then _emptyScans = 0 else _emptyScans = _emptyScans + 1 end
                if ok and pets and #pets > 0 then
                    local best
                    if type(_lockUid) == "string" and _lockUid ~= "" then
                        for _, p in ipairs(pets) do
                            if not p.conveyor and _petUid(p) == _lockUid then best = p break end
                        end
                    end
                    if not best and _G.SDRStealMode == "nearest" then
                        local myPos = hrp.Position
                        local bestD = math.huge
                        for _, p in ipairs(pets) do
                            if not p.conveyor and p.position then
                                local d = (p.position - myPos).Magnitude
                                if d < bestD then bestD = d; best = p end
                            end
                        end
                    elseif not best then
                        for _, p in ipairs(pets) do if not p.conveyor then best = p; break end end
                    end
                    best = best or pets[1]
                    if best then
                        _stealTarget = best
                        _stealArmedAt = now
                        _lastPickUid = _lockUid
                        if type(best.name) == "string" and best.name ~= "" then
                            _currentTargetName = best.name
                        end
                    end
                end
            end
        end
        if _G.SDRStealMode == "nearest"
            and not (type(_lockUid) == "string" and _lockUid ~= "") then
            local _c2 = LP.Character
            local _h2 = _c2 and _c2:FindFirstChild("HumanoidRootPart")
            if _h2 and (now - _inRangeLast) >= (tonumber(_G.SDRInRangeGap) or 0.15) then
                _inRangeLast = now
                local _pets2 = _scanCached(now, 0.15)
                if _pets2 ~= nil and type(_pets2) == "table" then
                    local _near, _nd = nil, math.huge
                    local _mp = _h2.Position
                    for _, p in ipairs(_pets2) do
                        if not p.conveyor and p.position then
                            local d = (p.position - _mp).Magnitude
                            if d < _nd then _nd, _near = d, p end
                        end
                    end
                    if _near then
                        local _nu = _petUid(_near)
                        if _nu ~= _G.SDRLastNearUid then
                            _G.SDRLastNearUid = _nu
                            
                        end
                        _stealTarget = _near
                        _armedPet, _armLostSince = nil, 0
                        _lastTargetPick = now
                        if type(_near.name) == "string" then _currentTargetName = _near.name end
                    end
                end
            end
        end
        local pet = _stealTarget
        if not pet then  return end

        if now - _stealLastScan < 0.02 then _G.SDRThrN = (_G.SDRThrN or 0) + 1 return end
        _stealLastScan = now
        local t = timeUntilCanSteal()
        if t == -1 then
            if LP:GetAttribute("Stealing") then _stealTarget = nil; _armedPet, _armLostSince = nil, 0 end
            
            return
        end
        if t > 0 and t > _holdDur() then  return end
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then  return end

        if pet.position then
            local toPet = pet.position - hrp.Position
            local dist = toPet.Magnitude
            if (now - (_G.__sdrTgtAt or 0)) >= 0.15 then
                _G.__sdrTgtAt = now
                _G.SDRStealTgt = tostring(pet.name) .. " [" .. tostring(pet.plot) .. "/" .. tostring(pet.slot) .. "] d=" .. math.floor(dist)
            end
            local hold = _holdDur()

            local lead = tonumber(_G.SDRStealLead) or 0.6

            local closing = dist > 0.001 and (hrp.AssemblyLinearVelocity:Dot(toPet) / dist) or 0

            local _nearBase = false
            do
                local _bi = getClosestBaseIdx(pet.position)
                local _b = _bi and BASES_LOW[_bi]
                if _b then
                    local _bx, _bz = hrp.Position.X - _b.X, hrp.Position.Z - _b.Z
                    if math.sqrt(_bx * _bx + _bz * _bz) <= (tonumber(_G.SDRCloseBaseRange) or 100) then
                        _nearBase = true
                    end
                end
            end

            local _armed = _G.SDRStealQuick ~= true
            local _mul = _armed and 1.5 or 1
            if _nearBase then
                if dist > (tonumber(_G.SDRNearBaseStealStart) or 80) * _mul then  return end
            elseif closing > (tonumber(_G.SDRFastApproach) or 150) then

                if dist > (tonumber(_G.SDRStealLeadMax) or 420) * _mul then  return end
                if (dist / closing) > hold * lead + (tonumber(_G.SDRStealEarly) or 0.35) * _mul then  return end
            elseif closing > 5 then

                if dist > (tonumber(_G.SDRCloseProximity) or 40) * _mul then  return end
            else

                if dist > _prox() * _mul then  return end
            end
        end
