        end)
        hclose.MouseButton1Click:Connect(function() hg.Enabled = false end)
        _G.SDRGriefSetEnabled = function(v)
            _G.SDRGriefEnabled = v and true or false
            gg.Enabled = _G.SDRGriefEnabled
            if not v then hg.Enabled = false end
            pcall(saveTpSettings)
        end
        _G.SDRGriefShowHistory = function() hg.Enabled = true; refreshHistory() end

        -- ---------- detection ----------
        local stealEnded, recent = 0, {}
        local stealPlot = nil   -- plot the animal being carried came from

        local function plotFromTarget()
            local t = _G.SDRStealTgt
            if type(t) == "string" then return t:match("%[([^/%]]+)/") end
            return nil
        end
        local function nearestPlot()
            local plots = WS:FindFirstChild("Plots")
            local c = LPl.Character
            local me = c and c:FindFirstChild("HumanoidRootPart")
            if not plots or not me then return nil end
            local idx = LPl:GetAttribute("StealingIndex")
            local best, bd, bestAll, bdAll
            for _, p in ipairs(plots:GetChildren()) do
                local ok, pv = pcall(function() return p:GetPivot().Position end)
                if ok then
                    local d = (pv - me.Position).Magnitude
                    if not bdAll or d < bdAll then bdAll, bestAll = d, p.Name end
                    local has = false
                    pcall(function()
                        local al = _G.SDR_GetPlotAnimalList and _G.SDR_GetPlotAnimalList(p.Name)
                        if type(al) == "table" and idx then
                            for _, e in pairs(al) do
                                if type(e) == "table" and tostring(e.Index) == tostring(idx) then has = true; break end
                            end
                        end
                    end)
                    if has and (not bd or d < bd) then bd, best = d, p.Name end
                end
            end
            return best or bestAll
        end
        local function ownerNameOf(plotName)
            if not plotName then return nil end
            local name
            pcall(function()
                local ch = _G.SDRSyncGet and _G.SDRSyncGet(plotName)
                local o = ch and channelGet and channelGet(ch, "Owner")
                if typeof(o) == "Instance" then name = o.Name
                elseif type(o) == "table" then name = o.Name
                elseif type(o) == "number" then local p = Players:GetPlayerByUserId(o); name = p and p.Name
                elseif type(o) == "string" and o ~= "" then name = o end
            end)
            if name then return name end
            pcall(function()
                local plot = WS:FindFirstChild("Plots") and WS.Plots:FindFirstChild(plotName)
                local sign = plot and plot:FindFirstChild("PlotSign")
                local sg = sign and sign:FindFirstChildWhichIsA("SurfaceGui", true)
                local l = sg and sg:FindFirstChildWhichIsA("TextLabel", true)
                local text = l and (l.Text or ""):lower() or ""
                for _, p in ipairs(Players:GetPlayers()) do
                    local dn, un = (p.DisplayName or ""):lower(), p.Name:lower()
                    if (dn ~= "" and text:find(dn, 1, true)) or (un ~= "" and text:find(un, 1, true)) then name = p.Name; break end
                end
            end)
            return name
        end
        local function isBaseOwner(griefer)
            local plotName = stealPlot or plotFromTarget() or nearestPlot()
            local owner = ownerNameOf(plotName)
            if not owner then return false end
            local gp = Players:FindFirstChild(griefer)
            local lo = owner:lower()
            return lo == griefer:lower() or (gp ~= nil and (gp.DisplayName or ""):lower() == lo)
        end
        local function queue(griefer, item)
            if not enabled() then return end
            if typeof(item) == "string" and (item == "" or item:sub(1, 1) == "#") then return end
            if not griefer or griefer == LPl.Name then return end
            local stealing = LPl:GetAttribute("Stealing") == true
            if not stealing and (tick() - stealEnded) > 0.5 then return end
            local key = griefer .. "|" .. tostring(item)
            if recent[key] and tick() - recent[key] < 3 then return end
            recent[key] = tick()
            addGrief(griefer, tostring(item), isBaseOwner(griefer))
        end
        LPl:GetAttributeChangedSignal("Stealing"):Connect(function()
