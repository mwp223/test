    pin.BorderSizePixel = 0
    pin.Parent = track
    Instance.new("UICorner", pin).CornerRadius = UDim.new(1, 0)

    local state = initialState

    local bindBadge = Instance.new("TextLabel")
    bindBadge.Size = UDim2.new(0, 40, 0, 12)
    bindBadge.Position = UDim2.new(1, -110, 0.5, -6)
