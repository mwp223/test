        startupError = tostring(message):match("^[^\n]+")
        toggle.Text="Startup failed · rerun after fixing"
    end
    if alive then status.Text=startupError or tostring(message) end
    warn("[Rose Nearest Instant] "..tostring(message))
end
local function requiredChild(parent,name)
    startupStage="Waiting for "..parent.Name.."/"..name
    if alive and not startupError then status.Text=startupStage end
    local child=parent:FindFirstChild(name) or parent:WaitForChild(name,15)
    assert(child,"Missing game dependency: "..parent:GetFullName().."/"..name)
    return child
end
