-- MWP Quick Pickup: clamp ProximityPrompt HoldDuration to 0.1 in your base
(function()
    local enabled = false
    local orig = {}
    local loopRunning = false
    local conns = {}

    local function isMyPlot(plot)
        if not plot or not plot:IsA("Model") then return false end
        local sign = plot:FindFirstChild("PlotSign")
        return sign and sign:FindFirstChild("YourBase") and sign.YourBase.Enabled
    end

    local function inMyPlot(inst)
        if not inst or not inst.Parent then return false end
        local node = inst.Parent
        for _ = 1, 12 do
            if not node then return false end
            if node:IsA("Model") and node.Parent and node.Parent.Name == "Plots" then
                return isMyPlot(node)
            end
            node = node.Parent
        end
        return false
    end

    local function clampPrompt(p)
        if not p or not p.Parent then return end
        if orig[p] == nil then orig[p] = p.HoldDuration end
        if p.HoldDuration ~= 0.1 then
            pcall(function() p.HoldDuration = 0.1 end)
        end
    end

    local function scanAll()
        local root = Workspace:FindFirstChild("Plots")
        if not root then return end
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("ProximityPrompt") and inMyPlot(d) then
                clampPrompt(d)
            end
        end
    end

    local function startLoop()
        if loopRunning then return end
        loopRunning = true
        task.spawn(function()
            while enabled do
                pcall(scanAll)
                task.wait(0.25)
            end
            loopRunning = false
        end)
    end

    local function connectWatchers()
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        conns = {}
        local root = Workspace:FindFirstChild("Plots")
        if root then
            table.insert(conns, root.DescendantAdded:Connect(function(d) if _G.SDRX_KILL_semi then return end 
                if enabled and d:IsA("ProximityPrompt") and inMyPlot(d) then
                    task.defer(clampPrompt, d)
                end
            end))
        end
        table.insert(conns, Workspace.ChildAdded:Connect(function(ch) if _G.SDRX_KILL_semi then return end 
            if enabled and ch.Name == "Plots" then
                connectWatchers()
            end
        end))
    end

    _G.MWP_SetQuickPickup = function(state)
        enabled = state and true or false
        if enabled then
            connectWatchers()
            scanAll()
            startLoop()
        else
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
            conns = {}
