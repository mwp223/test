        local _now = os.clock()
        if _G.__mwpResetBusy
            and (_now - (tonumber(_G.__mwpResetAt) or 0))
                < (tonumber(_G.MWPResetCooldown) or 2.5) then
            return
        end
        _G.__mwpResetBusy = true
        _G.__mwpResetAt   = _now

