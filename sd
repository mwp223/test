        return _xchan2
    end

    local inBoot2 = _gameLoadAt and (os.clock() - _gameLoadAt) < 4
    _nextTry2 = os.clock() + (inBoot2 and 0.1 or ((_G.SDRScanMode == "fast") and 0.03 or 0.1))
    return _xchan2
end
