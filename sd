-- Keep the source's task timing while making all background loops unloadable.
local function schedule(method,delay,fn,...)
    local args=table.pack(...)
    local thread
    thread=coroutine.create(function()
        local ok,err=xpcall(function()
            if alive then fn(table.unpack(args,1,args.n)) end
        end,debug.traceback)
        workers[thread]=nil
        if not ok and alive then report(err) end
    end)
    workers[thread]=true
    if method=="delay" then realTask.delay(delay,thread)
    elseif method=="defer" then realTask.defer(thread)
    else realTask.spawn(thread) end
    return thread
end
