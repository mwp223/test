    bindBadge.TextXAlignment = Enum.TextXAlignment.Right
    bindBadge.Parent = parentCard

    local bindBtn = Instance.new("TextButton")
    bindBtn.Size = UDim2.new(0, 16, 0, 16)
    bindBtn.Position = UDim2.new(1, -64, 0.5, -8)
    bindBtn.BackgroundColor3 = Color3.fromRGB(80, 30, 60)
    bindBtn.Text = "K"
    bindBtn.TextColor3 = COLOR_TEXT_LIGHT
    bindBtn.Font = MAIN_FONT
    bindBtn.TextSize = 9
    bindBtn.Parent = parentCard
    Instance.new("UICorner", bindBtn).CornerRadius = UDim.new(0, 4)

    local function fire()
        state = not state
        if state then
            TweenService:Create(track, TweenInfo.new(0.2), {BackgroundColor3 = COLOR_ACCENT}):Play()
            TweenService:Create(pin, TweenInfo.new(0.2), {Position = UDim2.new(1, -16, 0.5, -7), BackgroundColor3 = COLOR_BG_DARK}):Play()
        else
            TweenService:Create(track, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80, 30, 60)}):Play()
            TweenService:Create(pin, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -7), BackgroundColor3 = Color3.fromRGB(255, 180, 220)}):Play()
        end
        onClick(state)
    end

    track.MouseButton1Click:Connect(fire)
    local function beginBind()
        MWP_BindingTarget = { name = textLabel, fire = fire, badge = bindBadge }
        bindBadge.Text = "[...]"
    end
    track.MouseButton2Click:Connect(beginBind)
    bindBtn.MouseButton1Click:Connect(beginBind)

    local savedKey = MWP_PendingKeybinds and MWP_PendingKeybinds[textLabel]
    if savedKey then
        local ok, kc = pcall(function() return Enum.KeyCode[savedKey] end)
        if ok and kc then
            MWP_ToggleKeybinds[textLabel] = { key = kc, fire = fire }
            bindBadge.Text = "[" .. savedKey .. "]"
        end
    end

    return track, pin
end

