            end
        end)
        local function hrp() local c = LPl.Character; return c and c:FindFirstChild("HumanoidRootPart") end

        local holders = {}
        local function getHolder(gear)
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LPl and p.Character and p.Character:FindFirstChild(gear) then
                    holders[gear] = { name = p.Name, t = tick() }
