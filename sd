    local function N(k, d) return tonumber(_G[k]) or d end

    function sdrFlashSpot(petPos, upper)
        local list = {}
        pcall(function()
            if isfile and isfile("elite_flash_pos.json") then list = HttpS:JSONDecode(readfile("elite_flash_pos.json")) end
        end)
        if type(list) ~= "table" then list = {} end
        if upper == true then
            local hl
            pcall(function()
                if isfile and isfile("elite_flash_pos_high.json") then hl = HttpS:JSONDecode(readfile("elite_flash_pos_high.json")) end
            end)
            if type(hl) == "table" and #hl > 0 then
                local all = {}
                for _, e in ipairs(hl) do all[#all + 1] = e end
                for _, e in ipairs(list) do all[#all + 1] = e end
                list = all
            end
        end
        local myIdx
        pcall(function()
            local plots = workspace:FindFirstChild("Plots")
            local mine = plots and _G.SDRMyPlot and plots:FindFirstChild(_G.SDRMyPlot)
            if mine then myIdx = getClosestBaseIdx(mine:GetPivot().Position) end
        end)
        if not myIdx then return nil end
        local tIdx = getClosestBaseIdx(petPos)
        local function pick(want)
            for _, e in ipairs(list) do
                if e.my == myIdx and e.target == tIdx and (e.upper == true) == want
                    and type(e.pos) == "table" and type(e.look) == "table" then
                    local cam = type(e.cam) == "table" and Vector3.new(e.cam[1], e.cam[2], e.cam[3]) or nil
                    return Vector3.new(e.pos[1], e.pos[2], e.pos[3]), Vector3.new(e.look[1], 0, e.look[2]), cam
                end
            end
            for _, r in ipairs(want and BH or B) do
                if r[1] == myIdx and r[2] == tIdx then
                    return Vector3.new(r[3], r[4], r[5]), Vector3.new(r[6], 0, r[7]), Vector3.new(r[8], r[9], r[10])
                end
            end
            return nil
        end
        local pos, look, cam = pick(upper == true)
        if not pos then return nil end
        if look.Magnitude > 0.01 then pos = pos + look.Unit * N("SDRFlashForward", 3) end
        local b = BASES_LOW[tIdx]
        if look.Magnitude > 0.01 and b and ((pos.X - b.X) ^ 2 + (pos.Z - b.Z) ^ 2) <= 70 * 70 then
            _G.SDRFlashPair = myIdx .. "->" .. tIdx .. (upper == true and " HIGH" or " LOW")
            return pos, look.Unit, cam
        end
        return nil
    end

    local camOld, camDist
    function sdrFlashAimStop()
        local saved = camOld
        camOld = nil
        local cam = workspace.CurrentCamera
        if saved and cam then pcall(function() cam.CameraType = saved[1]; cam.CFrame = saved[2] end) end
    end
    local function camPos(dir)
        local h = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not h then return workspace.CurrentCamera.CFrame.Position end
        local head = h.Position + Vector3.new(0, 1.5, 0)
        local dist = camDist
        if not dist then
            local want = N("SDRFlashCamDist", 10)
            dist = want
            pcall(function()
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                local skip = {}
                for _, pl in ipairs(Players:GetPlayers()) do if pl.Character then skip[#skip + 1] = pl.Character end end
                for _ = 1, 8 do
                    rp.FilterDescendantsInstances = skip
                    local hit = workspace:Raycast(head, -dir * want, rp)
                    if not hit then break end
                    local p = hit.Instance
                    if p and p:IsA("BasePart") and not p.CanCollide and p.Transparency >= 0.9 then skip[#skip + 1] = p
                    else dist = math.max(1.5, (hit.Position - head).Magnitude - 0.6) break end
                end
            end)
            camDist = dist
        end
        return head - dir * dist
    end
    function sdrFlashAimStart(look, camLook)
        if not camOld then camDist = nil end
        local d = (typeof(camLook) == "Vector3" and camLook) or (typeof(look) == "Vector3" and look) or nil
        local dir = d and Vector3.new(d.X, 0, d.Z)
        local cam = workspace.CurrentCamera
        if not (cam and dir and dir.Magnitude > 0.01) then return end
        local token = {}
        if not camOld then camOld = { cam.CameraType, cam.CFrame, token } end
        local from = camPos(dir.Unit)
        local full = dir.Unit
        if _G.SDRFlingTP ~= true and _G.SDRFlashPitchAim == true and typeof(camLook) == "Vector3" and camLook.Magnitude > 0.01 then full = camLook.Unit end
        pcall(function() cam.CameraType = Enum.CameraType.Scriptable; cam.CFrame = CFrame.lookAt(from, from + full) end)
        task.delay(4, function()
            local s = camOld
            if s and s[3] == token then sdrFlashAimStop() end
        end)
    end
    function sdrFlashCleanup()
        pcall(function()
            local cam = workspace.CurrentCamera
            if cam and cam.CameraType == Enum.CameraType.Scriptable then cam.CameraType = Enum.CameraType.Custom end
            local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            if h then h.AutoRotate = true end
        end)
        camOld = nil
    end

    local function findFlashTool()
        local char = LP.Character
        local bp = LP:FindFirstChild("Backpack")
        local tool = (char and char:FindFirstChild("Flash Teleport")) or (bp and bp:FindFirstChild("Flash Teleport"))
        if tool then return tool end
        for _, holder in ipairs({ char, bp }) do
            if holder then
                for _, t in ipairs(holder:GetChildren()) do
                    local n = string.lower(t.Name)
                    if t:IsA("Tool") and n:find("flash", 1, true) and n:find("tele", 1, true) then return t end
                end
            end
        end
    end
    _G.SDRHasFlashTool = function() return findFlashTool() ~= nil end
    -- the tool exists and is not on cooldown (Enabled is false while it recharges)
    _G.SDRFlashReady = function()
        local t = findFlashTool()
        return t ~= nil and t.Enabled ~= false
    end

    function sdrFlashIn(look, camLook, spot, high)
        camDist = nil
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not (hum and hrp) then return false end
        local tool = findFlashTool()
        if not tool then return "notool" end
        if tool.Enabled == false then return "cooldown" end
        local d = (typeof(camLook) == "Vector3" and camLook) or (typeof(look) == "Vector3" and look) or nil
        local dir = d and Vector3.new(d.X, 0, d.Z)
        dir = (dir and dir.Magnitude > 0.01) and dir.Unit or nil
        local face = typeof(look) == "Vector3" and Vector3.new(look.X, 0, look.Z) or nil
        local aimFull = (_G.SDRFlingTP ~= true and _G.SDRFlashPitchAim == true and typeof(camLook) == "Vector3" and camLook.Magnitude > 0.01) and camLook.Unit or nil
        if face and face.Magnitude > 0.01 then
            pcall(function() hum.AutoRotate = false; hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + face.Unit) end)
        end
        local equipAt = 0
        local function equip()
            if tool.Parent ~= LP.Character then
                pcall(function() hum:EquipTool(tool) end)
                equipAt = os.clock()
                local t0 = os.clock()
                while tool.Parent ~= LP.Character and os.clock() - t0 < 1 do RS.Heartbeat:Wait() end
            end
        end
        local cam = workspace.CurrentCamera
        local saved = camOld
        local oldType = (saved and saved[1]) or (cam and cam.CameraType)
        local oldCF = (saved and saved[2]) or (cam and cam.CFrame)
        local lastPress = 0
        local function pin()
            local h = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            -- never fight the teleport itself: after a press only the camera/facing are held
            if h and typeof(spot) == "Vector3" and os.clock() - lastPress > 0.6 then
                local off = h.Position - spot
                local flat = Vector3.new(off.X, 0, off.Z).Magnitude
                if (flat > 0.8 or math.abs(off.Y) > 1.6) and off.Magnitude <= 6 then
                    local fw = (face and face.Magnitude > 0.01) and face.Unit or h.CFrame.LookVector
                    h.CFrame = CFrame.new(spot, spot + fw)
                    h.AssemblyLinearVelocity = Vector3.zero
                    h.AssemblyAngularVelocity = Vector3.zero
                elseif off.Magnitude <= 6 then
                    local v = h.AssemblyLinearVelocity
                    if Vector3.new(v.X, 0, v.Z).Magnitude > 1 then
                        h.AssemblyLinearVelocity = Vector3.new(0, math.min(v.Y, 0), 0)
                    end
                end
            end
            local h3 = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if h3 and face and face.Magnitude > 0.01 then
                local lk = h3.CFrame.LookVector
                local f = face.Unit
                if (lk.X * f.X + lk.Z * f.Z) / math.max(Vector3.new(lk.X, 0, lk.Z).Magnitude, 0.001) < 0.9998 then
                    pcall(function()
                        h3.CFrame = CFrame.new(h3.Position, h3.Position + Vector3.new(f.X, 0, f.Z))
                        h3.AssemblyAngularVelocity = Vector3.zero
                    end)
                end
            end
            if cam and dir then
                cam.CameraType = Enum.CameraType.Scriptable
                local cf = camPos(dir)
                cam.CFrame = CFrame.lookAt(cf, cf + (aimFull or dir))
            end
        end
        local function unpin()
            camOld = nil
            pcall(function()
                local h2 = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                if h2 then h2.AutoRotate = true end
            end)
            if cam and dir then pcall(function() cam.CameraType = oldType; cam.CFrame = oldCF end) end
        end
        local from = hrp.Position
        local deadline = os.clock() + N("SDRFlashMaxWait", 2.3)
        local ok = false
        equip()
        pcall(pin)
        do
            local since = os.clock() - equipAt
            local settle = (_G.SDRFlingTP == true or _G.SDRFlashPitchAim ~= true) and 0.05 or 0.18
            if since < settle then task.wait(settle - since) end
        end
        local handle = tool:FindFirstChild("Handle")
        local errS = handle and handle:FindFirstChild("ErrorSound")
        local recS = handle and handle:FindFirstChild("RechargeSound")
        local gotErr, ready = false, false
        local c1 = errS and errS.Played:Connect(function() gotErr = true end)
        local c2 = recS and recS.Played:Connect(function() ready = true end)
        local pad
        local function makePad()
            if pad or typeof(spot) ~= "Vector3" or _G.SDRFlashPlatform == false then return end
            pcall(function()
                local h = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                local hm = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                local feet = spot.Y - (h and h.Size.Y / 2 or 1) - (hm and hm.HipHeight or 2)
                pad = Instance.new("Part")
                pad.Name = "SDRFlashPad"
                pad.Size = Vector3.new(8, 1, 8)
                pad.Anchored = true
                pad.CanCollide = true
                pad.Transparency = 1
                pad.CFrame = CFrame.new(spot.X, feet - 0.5, spot.Z)
                pad.Parent = workspace
            end)
            local fp = pad
            task.delay(10, function() if fp and fp.Parent then pcall(function() fp:Destroy() end) end end)
        end
        makePad()
        do
            local hm = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            local tg = os.clock()
            if hm and hm.FloorMaterial == Enum.Material.Air then pcall(function() hm:ChangeState(Enum.HumanoidStateType.Landed) end) end
            while hm and hm.FloorMaterial == Enum.Material.Air and os.clock() - tg < N("SDRFlashGroundWait", 0.08) do
                pcall(pin); RS.Heartbeat:Wait()
            end
        end
        local teleS = handle and handle:FindFirstChild("TeleportSound")
        local going = false
        local c3 = teleS and teleS.Played:Connect(function() going = true end)
        local function moved()
            local h = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            return h ~= nil and (h.Position - from).Magnitude > 4
        end
        local nothing, presses = 0, 0
        while os.clock() < deadline and not ok do
            if tool.Parent ~= LP.Character then equip() end
            pcall(pin)
            gotErr, going = false, false
            pcall(function()
                local hm = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                if hm then
                    hm.Jump = false
                    if hm.Sit then hm.Sit = false end
                    if hm.PlatformStand then hm.PlatformStand = false end
                end
            end)
            if tool.Enabled == false then
                local te = os.clock()
                while tool.Enabled == false and os.clock() < deadline and os.clock() - te < 2 do pcall(pin); RS.Heartbeat:Wait() end
            end
            lastPress = os.clock()
            presses = presses + 1
            pcall(function() tool:Activate() end)
            local t0 = os.clock()
            while os.clock() < deadline do
                RS.Heartbeat:Wait()
                if moved() then ok = true break end
                pcall(pin)
                if gotErr then break end
                if not going and os.clock() - t0 >= N("SDRFlashRetry", 0.2) then break end
                if going and os.clock() - t0 >= 1.5 then break end
            end
            if not ok and not gotErr and not going then
                nothing = nothing + 1
                local hm = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                if hm and hm.FloorMaterial == Enum.Material.Air then makePad() end
                if nothing == 2 and _G.SDRFlashReequip ~= false then
                    pcall(function()
                        local hm2 = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                        if hm2 then hm2:UnequipTools() end
                    end)
                    RS.Heartbeat:Wait()
                    equip()
                    task.wait(0.08)
                end
                if nothing >= N("SDRFlashMaxTries", 2) then break end
            end
            if not ok and gotErr then
                ready = false
                while not ready and os.clock() < deadline do
                    if moved() then ok = true break end
                    pcall(pin)
                    RS.Heartbeat:Wait()
                end
            end
        end
        if c3 then c3:Disconnect() end
        if c1 then c1:Disconnect() end
        if c2 then c2:Disconnect() end
        local usedCamDist = camDist
        camDist = nil
        -- one line per attempt so a bad spot can be diagnosed: SDRFlash_log.txt
        pcall(function()
            if not writefile then return end
            local h = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            local hm = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            local line = string.format("%s | pair %s | %s | presses %d | nothing %d | tool %s | floor %s | from spot %.1f | pos %s | spot %s | ping %dms",
                os.date("%H:%M:%S"), tostring(_G.SDRFlashPair), ok and "OK" or "FAIL", presses, nothing,
                tool.Enabled == false and "disabled" or "ready",
                hm and tostring(hm.FloorMaterial):gsub("Enum.Material.", "") or "?",
                (h and typeof(spot) == "Vector3") and (h.Position - spot).Magnitude or -1,
                h and string.format("%.1f,%.1f,%.1f", h.Position.X, h.Position.Y, h.Position.Z) or "?",
                typeof(spot) == "Vector3" and string.format("%.1f,%.1f,%.1f", spot.X, spot.Y, spot.Z) or "?",
                math.floor((LP:GetNetworkPing() or 0) * 1000))
            local old = ""
            pcall(function() old = readfile("SDRFlash_log.txt") end)
            writefile("SDRFlash_log.txt", (old .. line .. "\n"):sub(-6000))
        end)
        if pad then pcall(function() pad:Destroy() end) end
        unpin()
        return ok
    end
end

-- ============================================================================
-- Sammydawg features: kick / kick-to-private-server / carpet speed, MWP instant reset
-- ============================================================================
do
    local TS = game:GetService("TeleportService")
    local RunSvc = game:GetService("RunService")
    local PG = LP:WaitForChild("PlayerGui")

    -- ---- kick ----
    _G.SDRKick = function()
        local ok = pcall(function()
            if game.Shutdown then game:Shutdown() else LP:Kick("\nSAMMYDAWG TP") end
        end)
        if not ok then pcall(function() LP:Kick("\nSAMMYDAWG TP") end) end
    end

    -- ---- rejoin server (same method as the MWP semi-TP: several teleport paths, then a kick the client reconnects from) ----
    local function buildRejoinLoadingGui()
        local sg = Instance.new("ScreenGui")
        sg.Name = "SDRRejoinLoader"
        sg.ResetOnSpawn = false
        sg.IgnoreGuiInset = true
        sg.DisplayOrder = 999999
        local bg = Instance.new("Frame", sg)
        bg.Size = UDim2.new(1, 0, 1, 0)
        bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        bg.BackgroundTransparency = 0
        bg.BorderSizePixel = 0
        local lbl = Instance.new("TextLabel", bg)
        lbl.Size = UDim2.new(1, 0, 0, 60)
        lbl.Position = UDim2.new(0, 0, 0.5, -30)
        lbl.BackgroundTransparency = 1
        lbl.Text = "Rejoining server..."
        lbl.TextColor3 = Color3.fromRGB(245, 245, 248)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 22
        return sg
    end
    _G.SDRRejoin = function()
        local placeId = game.PlaceId
        local jobId = game.JobId
        local privateId = game.PrivateServerId

        pcall(function() TS:SetTeleportGui(buildRejoinLoadingGui()) end)

        local queue = queue_on_teleport or (syn and syn.queue_on_teleport) or nil
        if queue then
            pcall(function() queue("-- rejoin marker") end)
        end

        local attempts
        if privateId ~= "" then
            attempts = {
                function() TS:TeleportToPlaceInstance(placeId, jobId) end,
                function() TS:TeleportToPlaceInstance(placeId, jobId, LP) end,
                function() TS:Teleport(placeId, LP) end,
            }
        else
            attempts = {
                function() TS:Teleport(placeId, LP) end,
                function() TS:TeleportToPlaceInstance(placeId, jobId, LP) end,
                function() TS:Teleport(placeId) end,
            }
        end

        local succeeded = false
        for _, fn in ipairs(attempts) do
            local ok = pcall(fn)
            if ok then succeeded = true; break end
            task.wait(0.15)
        end

        if not succeeded and privateId ~= "" then
            local ok, code = pcall(function() return TS:ReserveServer(placeId) end)
            if ok and code then
                pcall(function() TS:TeleportToPrivateServer(placeId, code, { LP }) end)
                succeeded = true
            end
        end

        task.delay(1.2, function()
            pcall(function()
                LP:Kick(succeeded and "Rejoin\n\nReconnecting to server..." or "Rejoin\n\nTeleport blocked - please rejoin manually.")
            end)
        end)
    end

    -- ---- kick to private server ----
    -- accepts: a privateServerLinkCode link, the bare link code, a roblox.com/share?code=...&type=Server link, or a bare share code
    local HttpSvc = game:GetService("HttpService")
    local function parsePS(input)
        if type(input) ~= "string" then return nil end
        input = input:gsub("%s+", "")
        if input == "" then return nil end
        local placeId = tonumber(input:match("/games/(%d+)"))
        local direct = input:match("[?&]privateServerLinkCode=([%w%-_]+)") or input:match("[?&]linkCode=([%w%-_]+)")
        if direct then return { code = direct, place = placeId } end
        local share = input:match("[?&]code=([%w%-_]+)")
        if share then return { share = share, place = placeId } end
        if input:match("^[%w%-_]+$") then
            if #input == 32 and input:match("^[0-9a-f]+$") and input:match("%a") then return { share = input, place = placeId } end
            return { code = input, place = placeId }
        end
    end
    local function httpReq(opts)
        local req = request or http_request or (syn and syn.request) or (fluxus and fluxus.request)
        if not req then return nil end
        local ok, res = pcall(req, opts)
        return ok and res or nil
    end
    -- turn a share link into a link code through roblox's share-link API (needs the executor's request function)
    local function resolveShare(shareCode)
        local body = HttpSvc:JSONEncode({ linkId = shareCode, linkType = "Server" })
        local url = "https://apis.roblox.com/sharelinks/v1/resolve-link"
        local headers = { ["Content-Type"] = "application/json" }
        local res = httpReq({ Url = url, Method = "POST", Headers = headers, Body = body })
        if res and res.StatusCode == 403 then
            local token
            for k, v in pairs(res.Headers or {}) do if tostring(k):lower() == "x-csrf-token" then token = v end end
            if token then
                headers["x-csrf-token"] = token
                res = httpReq({ Url = url, Method = "POST", Headers = headers, Body = body })
            end
        end
        if not (res and res.Body) then return nil end
        local ok, data = pcall(function() return HttpSvc:JSONDecode(res.Body) end)
        local inv = ok and type(data) == "table" and data.privateServerInviteData
        if type(inv) == "table" and inv.linkCode then return inv.linkCode, tonumber(inv.placeId) end
        return nil
    end
    local resolved = { key = nil, code = nil, place = nil }
    local function resolvePS(input)
        if resolved.key == input and resolved.code then return resolved.code, resolved.place end
        local parsed = parsePS(input)
        if not parsed then return nil end
        local code, place = parsed.code, parsed.place
        if not code and parsed.share then
            local c, pl = resolveShare(parsed.share)
            code, place = c, pl or place
        end
        if code then resolved.key, resolved.code, resolved.place = input, code, place end
        return code, place
    end
    -- resolve in the background whenever the link changes so the kick itself is instant
    _G.SDRPrepPrivateServer = function()
        task.spawn(function() pcall(resolvePS, _G.SDRPrivateServerLink) end)
    end
    local inFlight = false
    _G.SDRKickToPrivateServer = function()
        if inFlight then return false, "already in flight" end
        local code, placeId = resolvePS(_G.SDRPrivateServerLink)
        if not code then return false, "could not read a private server link (paste a link or code in settings)" end
        placeId = placeId or game.PlaceId
        inFlight = true
        local ok = pcall(function()
            game:GetService("ExperienceService"):LaunchExperience({ placeId = placeId, linkCode = code })
        end)
        local ok2, err = false, nil
        if not ok then
            ok2, err = pcall(function() TS:TeleportToPrivateServer(placeId, code, { LP }) end)
        end
        if ok or ok2 then
            -- if we are still here a moment later, try the other route; if that fails too, kick like a normal auto kick
            task.delay(2.5, function()
                if not ok2 then pcall(function() TS:TeleportToPrivateServer(placeId, code, { LP }) end) end
                task.delay(3, function() inFlight = false; if _G.SDRKick then _G.SDRKick() end end)
            end)
            return true
        end
        inFlight = false
        return false, tostring(err)
    end

    -- ---- auto kick on steal ("You stole ..." popup) ----
    local stoleHandled = 0
    local function checkSteal(gui)
        if not (gui:IsA("TextLabel") or gui:IsA("TextButton")) then return end
        local txt = gui.Text
        if not (txt and string.find(txt, "You stole")) then return end
        if tick() - stoleHandled < 3 then return end
        if _G.SDRKickToPS == true then
            stoleHandled = tick()
            -- same trigger as the normal auto kick, but it sends you to the private server; if that cannot work it kicks normally
            local ok, why = _G.SDRKickToPrivateServer()
            if not ok then warn("[kick to private server] " .. tostring(why)); _G.SDRKick() end
        elseif _G.SDRAutoKickOnSteal == true then
            stoleHandled = tick()
            _G.SDRKick()
        end
    end
    PG.DescendantAdded:Connect(function(gui)
        checkSteal(gui)
        if gui:IsA("TextLabel") or gui:IsA("TextButton") then
            gui:GetPropertyChangedSignal("Text"):Connect(function() checkSteal(gui) end)
        end
    end)
    task.defer(function() task.wait(1); if _G.SDRPrepPrivateServer then _G.SDRPrepPrivateServer() end end)

    -- ---- carpet speed ----
    local csConn
    _G.SDRCarpetSpeedOn = false
    _G.SDRSetCarpetSpeed = function(on)
        if on and (LP:GetAttribute("Stealing") or isTeleporting) then on = false end
        _G.SDRCarpetSpeedOn = on and true or false
        if csConn then csConn:Disconnect(); csConn = nil end
        if not on then return end
        csConn = RunSvc.Heartbeat:Connect(function() if _G.SDRX and _G.SDRX.mainPaused then return end 
            if isTeleporting or LP:GetAttribute("Stealing") then
                _G.SDRSetCarpetSpeed(false)
                if _G.SDRRepaintCarpet then pcall(_G.SDRRepaintCarpet) end
                return
            end
            local c = LP.Character
            local hum = c and c:FindFirstChildOfClass("Humanoid")
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            if not hum or not hrp then return end
            local toolName = _G.SDRCarpetTool
            local has = toolName and c:FindFirstChild(toolName)
            if not has then
                for _, n in ipairs(CARPET_NAMES) do
                    if c:FindFirstChild(n) then has = true break end
                end
            end
            if not has and toolName then
                local bp = LP:FindFirstChild("Backpack")
                local tb = bp and bp:FindFirstChild(toolName)
                if tb then pcall(function() hum:EquipTool(tb) end); has = tb end
            end
            if has then
                local spd = math.clamp(tonumber(_G.SDRCarpetSpeedValue) or 140, 20, 600)
                local md = hum.MoveDirection
                local v = hrp.AssemblyLinearVelocity
                if md.Magnitude > 0 then
                    hrp.AssemblyLinearVelocity = Vector3.new(md.X * spd, v.Y, md.Z * spd)
                else
                    hrp.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
                end
            end
        end)
    end

    -- ---- hit / drop recovery (Sammydawg): after a ragdoll or a dropped animal, go straight back to it ----
    do
        local wasRag, wasCarry = false, false
        local target, targetAt, targetNear = nil, 0, false     -- what we were going for before the hit
        local carryPet                                         -- the animal we picked up
        local pendingPet, pendingAt                            -- an animal that was dropped and still needs a return trip
        local tries, winStart = 0, 0
        local lastChar, carryChar

        local function goBack(pet)
            if tick() - winStart > 8 then tries, winStart = 0, tick() end
            tries = tries + 1
            if tries > 3 then return end
            pcall(function()
                for _, p in ipairs(scanForTP()) do
                    if _petUid(p) == _petUid(pet) then pet = p break end
                end
            end)
            if not pet.position then return end
            isTeleporting = true
            task.spawn(function()
                pcall(goToBrainrot, pet.position, pet.slot)
                isTeleporting = false
                if _G.SDRArmSteal then pcall(_G.SDRArmSteal, pet) end
            end)
        end

        task.spawn(function()
            while true do
                task.wait(0.1)
                local rem = (tonumber(LP:GetAttribute("RagdollEndTime")) or 0) - workspace:GetServerTimeNow()
                local carrying = LP:GetAttribute("Stealing") == true
                local c = LP.Character
                local hrp = c and c:FindFirstChild("HumanoidRootPart")
                local hum = c and c:FindFirstChildOfClass("Humanoid")

                -- a reset / respawn wipes everything we were tracking (otherwise it still thinks we are in the old base)
                if c ~= lastChar or _G.__mwpResetBusy then
                    lastChar = c
                    target, targetNear, carryPet, pendingPet, carryChar = nil, false, nil, nil, nil
                    wasRag, wasCarry = false, carrying
                end

                -- remember the animal we are working on while we are not carrying anything
                if rem <= 0.05 and not carrying then
                    local t = (_G.SDRStealTargetUID and _G.SDRStealTarget)
                        or (type(_G.SDRCurrentTarget) == "function" and _G.SDRCurrentTarget()) or nil
                    if t and t.position then
                        target, targetAt = t, tick()
                        targetNear = hrp ~= nil and (hrp.Position - t.position).Magnitude <= 90
                    end
                end

                -- pick-up edge: keep the animal we picked up; drop edge: queue a return trip if we are still in its base
                if carrying and not wasCarry then
                    local pet = (target and tick() - targetAt < 20) and target or nil
                    if not pet and hrp then
                        -- no remembered target: take the animal closest to us from the last scan (it vanishes from new scans once picked up)
                        local okc, list = pcall(scanAllPetsCached, 8)
                        if okc and type(list) == "table" then
                            local bestd = 45
                            for _, p in ipairs(list) do
                                if p.position then
                                    local d = (p.position - hrp.Position).Magnitude
                                    if d < bestd then bestd, pet = d, p end
                                end
                            end
                        end
                    end
                    carryPet = pet
                    carryChar = c
                elseif wasCarry and not carrying then
                    local pet = carryPet
                    carryPet = nil
                    if pet and pet.position and hrp and hum and hum.Health > 0
                        and carryChar == c and not _G.__mwpResetBusy then
                        -- dropped while still inside that animal's base?
                        local inPlot = false
                        local plotsF = workspace:FindFirstChild("Plots")
                        local plotM = pet.plot and plotsF and plotsF:FindFirstChild(pet.plot)
                        local pv
                        if plotM then pcall(function() pv = plotM:GetPivot().Position end) end
                        if pv then
                            inPlot = math.abs(hrp.Position.X - pv.X) < 60 and math.abs(hrp.Position.Z - pv.Z) < 60
                        else
                            inPlot = (hrp.Position - pet.position).Magnitude <= (tonumber(_G.SDRDropRecoverRange) or 90)
                        end
                        if inPlot then pendingPet, pendingAt = pet, tick() end
                    end
                end
                wasCarry = carrying

                if rem > 0.05 then
                    wasRag = true
                elseif wasRag then
