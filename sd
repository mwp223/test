    end
end

-- load gate: character standing on the ground, all plots streamed in and our own base known (returns as soon as that is true)
_G.SDRWaitLoaded = function(cap)
    local t0, settledSince = os.clock(), nil
    if not game:IsLoaded() then game.Loaded:Wait() end
    while os.clock() - t0 < (cap or 40) do
        local c = LP.Character
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        local hum = c and c:FindFirstChildOfClass("Humanoid")
        local plots = workspace:FindFirstChild("Plots")
        local ok = hrp ~= nil and hum ~= nil and hum.Health > 0 and hum.FloorMaterial ~= Enum.Material.Air
            and plots ~= nil and #plots:GetChildren() >= (tonumber(_G.SDRPlotsNeeded) or 8)
            and _G.SDRMyPlot ~= nil
        if ok then
            settledSince = settledSince or os.clock()
            if os.clock() - settledSince >= 0.3 then return end
        else
            settledSince = nil
        end
        task.wait(0.1)
    end
end

