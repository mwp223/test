    -- ---- world snapshot: undo FPS boosters / lighting changes when a method is destroyed ----
    local Lighting = game:GetService("Lighting")
    local LIGHT_PROPS = { "GlobalShadows", "Brightness", "FogEnd", "FogStart", "FogColor", "Ambient", "OutdoorAmbient",
        "ClockTime", "ExposureCompensation", "EnvironmentDiffuseScale", "EnvironmentSpecularScale", "ShadowSoftness" }
    local ENABLED_CLASSES = { ParticleEmitter = true, Trail = true, Beam = true, Fire = true, Smoke = true,
        Sparkles = true, PointLight = true, SpotLight = true, SurfaceLight = true, BloomEffect = true,
        BlurEffect = true, ColorCorrectionEffect = true, DepthOfFieldEffect = true, SunRaysEffect = true, Atmosphere = false }

    local function takeWorldSnap()
        local s = { light = {}, items = {} }
        pcall(function() s.q = settings().Rendering.QualityLevel end)
        for _, p in ipairs(LIGHT_PROPS) do pcall(function() s.light[p] = Lighting[p] end) end
        local function scan(root)
            local n = 0
            for _, d in ipairs(root:GetDescendants()) do
                local ok = pcall(function()
                    if d:IsA("BasePart") then
                        local e = { d, "part", d.Material, d.Reflectance, d.CastShadow }
                        if d:IsA("MeshPart") then e[6] = d.TextureID end
                        s.items[#s.items + 1] = e
                    elseif d:IsA("Decal") or d:IsA("Texture") then
                        s.items[#s.items + 1] = { d, "tex", d.Transparency }
                    elseif ENABLED_CLASSES[d.ClassName] then
                        s.items[#s.items + 1] = { d, "en", d.Enabled }
                    end
                end)
                n = n + 1
                if n % 2500 == 0 then realTask.wait() end
            end
        end
        scan(workspace)
        scan(Lighting)
        return s
    end

    local function restoreWorldSnap(s)
        if not s then return end
        pcall(function() if s.q then settings().Rendering.QualityLevel = s.q end end)
        for p, v in pairs(s.light) do pcall(function() if Lighting[p] ~= v then Lighting[p] = v end end) end
        local n = 0
        for _, e in ipairs(s.items) do
            local d, kind = e[1], e[2]
            pcall(function()
                if d.Parent then
                    if kind == "part" then
                        if d.Material ~= e[3] then d.Material = e[3] end
                        if d.Reflectance ~= e[4] then d.Reflectance = e[4] end
                        if d.CastShadow ~= e[5] then d.CastShadow = e[5] end
                        if e[6] and d.TextureID ~= e[6] then d.TextureID = e[6] end
                    elseif kind == "tex" then
                        if d.Transparency ~= e[3] then d.Transparency = e[3] end
                    else
                        if d.Enabled ~= e[3] then d.Enabled = e[3] end
                    end
