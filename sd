                        local lp = c:FindFirstChild(child.Name)
                        if lp and (child.Position - lp.Position).Magnitude <= 2 then
                            lastMedusa = tick()
                            mc:Disconnect()
                            queue(h.Name, "Medusa's Head")
                        end
                    end)
                end
            end
            if child.Name == "WebRope" and child:IsA("RopeConstraint") then
