        local function watchDoge(child)
            local user = child.Name:match("^PlayerName_(.+)_Doge$")
            if not user or user == LPl.Name or watchedDoge[child] then return end
            watchedDoge[child] = true
            local parts = child:IsA("BasePart") and { child } or child:GetDescendants()
