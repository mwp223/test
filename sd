function velMoveThrough(hrp, waypoints, speedOverride, allowJump, quickStart)
    if not hrp or not hrp.Parent or #waypoints == 0 then return end
    local _runSpeed = speedOverride or (_G.TPVelocity and math.clamp(_G.TPVelocity, 200, 750)) or CARPET_SPEED
    vizPath(hrp.Position, waypoints)
    local wpIdx = 1
    local done = false
    local conn
    -- noclip while flying so walls, fences and plot geometry can't snag the flight; collisions come back on arrival
    local noclipConn, ncOrig
    local function stopNoclip()
        if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
        if ncOrig then
            for p, v in pairs(ncOrig) do
                if p and p.Parent then pcall(function() p.CanCollide = v end) end
            end
            ncOrig = nil
        end
    end
    if _G.SDRTPNoclip ~= false and hrp.Parent then
        ncOrig = {}
        noclipConn = RunService.Stepped:Connect(function() if _G.SDRX and _G.SDRX.mainPaused then return end 
            local ch = hrp and hrp.Parent
            if not ch or done then return end
            for _, part in ipairs(ch:GetDescendants()) do
                if part:IsA("BasePart") then
                    if ncOrig and ncOrig[part] == nil then ncOrig[part] = part.CanCollide end
                    if part.CanCollide then part.CanCollide = false end
                end
            end
        end)
    end
    local function finish()
        if done then return end
        done = true
        if hrp and hrp.Parent then
            _vzL(hrp)
            _vzA(hrp)
            local _, y = hrp.CFrame:ToEulerAnglesYXZ()
            hrp.CFrame = CFrame.new(waypoints[#waypoints]) * CFrame.Angles(0, y, 0)
        end
        stopNoclip()
        if conn then conn:Disconnect() end
    end
    local lastDist, stall = math.huge, 0

    local _stStart = os.clock()
    local _lastJump = 0
    local _lastRearm = 0

    local _routeLen = 0
    do
        local _p = hrp.Position
        for _, wp in ipairs(waypoints) do
            _routeLen = _routeLen + (_p - wp).Magnitude
            _p = wp
        end
    end
    local _mayJump = _routeLen >= (tonumber(_G.SDRJumpMinDist) or 100)

    local _ = quickStart

    conn = RunService.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function() if _G.SDRX and _G.SDRX.mainPaused then return end 
        if not hrp or not hrp.Parent or done then
            stopNoclip()
            if conn then conn:Disconnect() end
            return
        end
        if _G.SDRTPStop then finish() return end
        if _G.__SDRFlashNearFn and wpIdx == #waypoints
            and (waypoints[wpIdx] - hrp.Position).Magnitude <= (tonumber(_G.SDRFlashPreEquip) or 40) then
            local _nf = _G.__SDRFlashNearFn
            _G.__SDRFlashNearFn = nil
            pcall(_nf)
        end
        if not (_G.JAF_Rearming and _G.JAF_Rearming()) and not _G.__SDRFlashHolding then equipCarpet() end
        if _mayJump and _G.SDRJumpEachStep ~= false then
            local _now = os.clock()
            if _now - _lastJump >= (tonumber(_G.SDRJumpGap) or 0.2) then
                _lastJump = _now
                local _jh = hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
                if _jh then
                    pcall(function() _jh:ChangeState(Enum.HumanoidStateType.Jumping) end)
                    pcall(function() _jh.Jump = true end)
                end
            end
        end
        local target = waypoints[wpIdx]
        local diff = target - hrp.Position
        local mag = diff.Magnitude
        local _spd = _runSpeed
        if _G.SDRAlwaysGrapple ~= false and _G.SDRFlingTP ~= true and isTeleporting and _G.JAF_BoostActive and not _G.JAF_BoostActive()
            and os.clock() - _lastRearm > (tonumber(_G.SDRGrappleRearmGap) or 0.5) then
            _lastRearm = os.clock()
            if _G.JAF_GrappleBoostNow then task.spawn(_G.JAF_GrappleBoostNow, target) end
        end
        if _G.SDRTPSyncPet and not _G.SDRTPSyncStarted and _G.SDRFireStealNow then
            local _pp = _G.SDRTPSyncPet.position
            if _pp and (hrp.Position - _pp).Magnitude <= (tonumber(_G.SDRTPSyncRadius) or 95) then
                _G.SDRTPSyncStarted = true
                task.spawn(_G.SDRFireStealNow, _G.SDRTPSyncPet)
            end
        end
        if wpIdx < #waypoints and mag < 26 then
            local nxt = waypoints[wpIdx + 1]
            local b = nxt - target
            if mag > 0.1 and b.Magnitude > 0.1 and diff.Unit:Dot(b.Unit) < 0.9 then
                _spd = math.min(_spd, 240)
            end
        end
        local _arr = math.max(MK_ARRIVE, _spd / 60 * 1.25)
        if mag < _arr then
            wpIdx = wpIdx + 1
            if wpIdx > #waypoints then finish() return end
            lastDist, stall = math.huge, 0
            if _G.SDRZeroEachStep ~= false and _vzOK() then
                pcall(function()
                    local _v = hrp.AssemblyLinearVelocity
                    local _keepY = (_G.SDRZeroStepKeepY == false) and 0 or math.max(_v.Y, 0)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, _keepY, 0)
                    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end)
            end
            if _mayJump and _G.SDRJumpEachStep ~= false then
                local _wh = hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
                if _wh then
                    _lastJump = os.clock()
                    pcall(function() _wh:ChangeState(Enum.HumanoidStateType.Jumping) end)
                    pcall(function() _wh.Jump = true end)
                end
            end
            target = waypoints[wpIdx]
            diff = target - hrp.Position
            mag = diff.Magnitude
        end

        if mag > lastDist - 0.05 then stall = stall + 1 else stall = 0 end
        lastDist = mag
        if stall >= (tonumber(_G.SDRStallFrames) or 18) then finish() return end

        if mag >= 0.1 then
            local dir = diff.Unit
            if (allowJump or diff.Y > 10) and diff.Y > 5 and wpIdx < #waypoints then
                local hum = hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
