    -- ---------------- hazards: turret / trap / mine ----------------
    local KINDS = {
        turret = { color = Color3.fromRGB(255, 40, 40), text = "TURRET" },
        trap = { color = Color3.fromRGB(255, 150, 20), text = "TRAP" },
        mine = { color = Color3.fromRGB(167, 142, 255), text = "SUBSPACE MINE" },
    }
    local function hazardKind(name)
        local ln = name:lower()
        if ln:find("sentrybullet", 1, true) then return nil end
        if ln:find("tripmine", 1, true) then return "mine" end
        if ln:find("sentry", 1, true) then return "turret" end
        if ln:find("trap", 1, true) or ln:find("hive", 1, true) then return "trap" end
        return nil
    end
    local hazards = {}
    local function dropHazard(obj, d)
        if d.hl and d.hl.Parent then d.hl:Destroy() end
        if d.bb and d.bb.Parent then d.bb:Destroy() end
        hazards[obj] = nil
    end
    local function makeHazard(target, kind)
        local spec = KINDS[kind]
        local text = "⚠ " .. spec.text .. " ⚠"
        if kind == "mine" then
            local owner = target.Name:match("SubspaceTripmine(.+)")
            if owner then
                local pl = Players:FindFirstChild(owner)
                text = "⚠ " .. ((pl and pl.DisplayName) or owner) .. "'s MINE ⚠"
            end
        end
        local hl
        if target:IsA("Model") then
            hl = Instance.new("Highlight")
            hl.FillColor, hl.FillTransparency, hl.OutlineColor = spec.color, 0.25, WHITE
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = target
            hl.Name = "SammyHazardESP"
            hl.Parent = target
        else
            hl = Instance.new("SelectionBox")
            hl.Name = "SammyHazardESP"
            hl.Adornee = target
            hl.Color3, hl.LineThickness, hl.SurfaceColor3, hl.SurfaceTransparency = spec.color, 0.12, spec.color, 0.6
            hl.Parent = target
        end
        local ad = target:IsA("BasePart") and target or target:FindFirstChildWhichIsA("BasePart", true) or target
        local bb = label(target, ad, text, spec.color, UDim2.new(0, 200, 0, 40), 6)
        bb.Name = "SammyHazardESPLabel"
        return { hl = hl, bb = bb, kind = kind }
    end
    task.spawn(function()
        while true do
            local on = { turret = flags.turret, trap = flags.trap, mine = flags.mine }
            local current = {}
            if on.turret or on.trap or on.mine then
                local all = WS:GetDescendants()
                local n, t0 = 0, os.clock()
                for i = 1, #all do
                    n = n + 1
                    if n >= 250 or os.clock() - t0 > 0.002 then RunSvc.Heartbeat:Wait(); n = 0; t0 = os.clock() end
                    local inst = all[i]
                    if inst and (inst.ClassName == "Model" or inst:IsA("BasePart")) then
                        local kind = hazardKind(inst.Name)
                        if kind and on[kind] and not inst:FindFirstChildWhichIsA("Humanoid", true) then
                            local skip, par = false, inst
                            while par and par ~= WS do
                                if Players:GetPlayerFromCharacter(par) then skip = true break end
                                if par ~= inst and hazardKind(par.Name) then skip = true break end
                                par = par.Parent
                            end
                            if not skip then
                                current[inst] = true
                                local d = hazards[inst]
                                if d and d.kind ~= kind then dropHazard(inst, d); d = nil end
                                if not d then hazards[inst] = makeHazard(inst, kind) end
                            end
                        end
                    end
                end
            end
            for obj, d in pairs(hazards) do
                if not current[obj] or not obj.Parent then dropHazard(obj, d) end
            end
            task.wait(3)
