                end
                lastVelocity = v
            end
        end))
        local f = 0
        add(RunService.Heartbeat:Connect(function() if _G.SDRX and _G.SDRX.mainPaused then return end 
            f = f + 1
            if f < 2 then return end
            f = 0
            if active() and aOn() then recover() end
        end))
        add(hum.StateChanged:Connect(function()
            if active() and ragdolled() then
                if not carpetOn() then hum:ChangeState(ST.Running) end
                cleanupRagdoll(); camera(); controls()
            end
        end))
        add(char.DescendantAdded:Connect(function()
            if not active() then return end
            if ragdolled() then cleanupRagdoll() end
            if aOn() then fixA() end
        end))
        if active() then harden(hum) end
    end
    local function bind(c)
        clear()
        char, hum, root, animator = nil, nil, nil, nil
        local h = c:WaitForChild("Humanoid", 10)
        local r = c:WaitForChild("HumanoidRootPart", 10)
        if not h or not r then return end
        char, hum, root = c, h, r
        animator = h:WaitForChild("Animator", 10)
        lastVelocity = Vector3.zero
        setup()
    end
    LP.CharacterAdded:Connect(function(c) while _G.SDRX and _G.SDRX.mainPaused do task.wait(0.25) end  task.spawn(bind, c) end)
    if LP.Character then task.spawn(bind, LP.Character) end
end

-- ============================================================================
-- INCOMING SLOT: when someone is carrying an animal, mark the slot in their base where it will land
-- and turn Instant Snipe on automatically when you are standing on it.
-- ============================================================================
do
    local WS = workspace
    local marks = {}          -- thief Player -> { anchor, label, slot, plotName }
    local folder
    local autoBy = false      -- instant snipe was switched on by this feature
    local lastIncoming = 0

    local function plotOwnerOf(plot)
        local sign = plot:FindFirstChild("PlotSign")
        local gui = sign and sign:FindFirstChildWhichIsA("SurfaceGui", true)
        local tl = gui and gui:FindFirstChildWhichIsA("TextLabel", true)
        if tl and tl.Text then
            local nick = tl.Text:match("^(.-)'") or tl.Text
            for _, p in ipairs(Players:GetPlayers()) do
                if p.DisplayName == nick or p.Name == nick then return p end
            end
        end
    end
    local function ensureFolder()
        if folder and folder.Parent then return folder end
        folder = Instance.new("Folder")
        folder.Name = "SDRIncomingSlots"
        folder.Parent = WS
        return folder
    end
    local function drop(plr)
        local m = marks[plr]
        if m then
            if m.anchor then m.anchor:Destroy() end
            marks[plr] = nil
        end
    end
    -- the slot the stolen animal will most likely land in: the lowest empty slot of the thief's base
    local function incomingSlot(plot)
        local podiums = plot:FindFirstChild("AnimalPodiums")
        if not podiums then return nil end
        local okC, ch = pcall(getPlotChannel, plot.Name)
        if not okC or not ch then return nil end
        local okL, list = pcall(channelGet, ch, "AnimalList")
        if not okL or type(list) ~= "table" then return nil end
        local count = #podiums:GetChildren()
        for k = 1, math.max(count, 1) do
            local occ = list[k] or list[tostring(k)]
            if type(occ) ~= "table" then
                local pod = podiums:FindFirstChild(tostring(k))
                local base = pod and pod:FindFirstChild("Base")
                local sp = base and (base:FindFirstChild("Spawn") or base:FindFirstChildWhichIsA("BasePart"))
                if sp then return k, sp.Position end
            end
        end
        return nil
    end

    task.spawn(function()
        while true do
            task.wait(0.4)
            local on = type(_G.SDRESPGet) == "function" and _G.SDRESPGet("incoming")
            if not on then
                for plr in pairs(marks) do drop(plr) end
                if autoBy and _G.SDRInstantOn == true and type(_G.SDRInstantSetEnabled) == "function" then
                    pcall(_G.SDRInstantSetEnabled, false)
                end
                autoBy = false
                continue
            end
            local plots = WS:FindFirstChild("Plots")
            local byOwner = {}
            if plots then
                for _, plot in ipairs(plots:GetChildren()) do
                    local o = plotOwnerOf(plot)
                    if o then byOwner[o] = plot end
                end
            end
            local seen = {}
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LP and plr:GetAttribute("Stealing") == true then
                    local plot = byOwner[plr]
                    if plot then
                        local slot, pos = incomingSlot(plot)
                        if slot and pos then
                            seen[plr] = true
                            local m = marks[plr]
                            if not m or m.slot ~= slot or m.plotName ~= plot.Name then
                                drop(plr)
                                local anchor = Instance.new("Part")
                                anchor.Anchored = true; anchor.CanCollide = false; anchor.CanQuery = false; anchor.CanTouch = false
                                anchor.Transparency = 1; anchor.Size = Vector3.new(0.5, 0.5, 0.5)
                                anchor.Position = pos + Vector3.new(0, 5, 0)
                                anchor.Parent = ensureFolder()
                                local bb = Instance.new("BillboardGui", anchor)
                                bb.Size = UDim2.new(0, 190, 0, 40); bb.AlwaysOnTop = true; bb.LightInfluence = 0; bb.MaxDistance = 3000
                                local tl = Instance.new("TextLabel", bb)
                                tl.Size = UDim2.new(1, 0, 1, 0); tl.BackgroundTransparency = 1
                                tl.Text = "INCOMING SLOT\n" .. plr.DisplayName
                                tl.Font = Enum.Font.GothamBold; tl.TextSize = 14; tl.TextColor3 = Color3.fromRGB(120, 235, 150)
                                tl.TextStrokeTransparency = 0
                                local ring = Instance.new("Part")
                                ring.Anchored = true; ring.CanCollide = false; ring.CanQuery = false; ring.CanTouch = false
                                ring.Material = Enum.Material.Neon; ring.Color = Color3.fromRGB(120, 235, 150)
                                ring.Transparency = 0.55; ring.Shape = Enum.PartType.Cylinder
                                ring.Size = Vector3.new(0.2, 8, 8)
                                ring.CFrame = CFrame.new(pos + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90))
                                ring.Parent = anchor
                                marks[plr] = { anchor = anchor, slot = slot, plotName = plot.Name, pos = pos }
                            end
                        end
                    end
                end
            end
            for plr in pairs(marks) do
                if not seen[plr] then drop(plr) end
            end
            -- standing on an incoming slot: turn Instant Snipe on
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            local any = false
            if hrp then
                for _, m in pairs(marks) do
                    any = true
                    local d = hrp.Position - m.pos
                    if Vector3.new(d.X, 0, d.Z).Magnitude <= (tonumber(_G.SDRIncomingRange) or 7) and math.abs(d.Y) <= 10 then
                        if _G.SDRInstantOn ~= true and type(_G.SDRInstantSetEnabled) == "function" then
                            pcall(_G.SDRInstantSetEnabled, true)
                            autoBy = true
                        end
                    end
                end
            end
            if any then lastIncoming = os.clock() end
            -- we switched it on: switch it off again a few seconds after the incoming slot is gone
            if autoBy and not any and os.clock() - lastIncoming > 6 then
                if _G.SDRInstantOn == true and type(_G.SDRInstantSetEnabled) == "function" then
                    pcall(_G.SDRInstantSetEnabled, false)
                end
                autoBy = false
            end
        end
    end)
end

