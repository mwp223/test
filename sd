                    wc = RS.Heartbeat:Connect(function()
                        if paused() then return end
                        if not child.Parent then wc:Disconnect(); return end
                        local c = LPl.Character
                        if c and ((child.Attachment0 and child.Attachment0:IsDescendantOf(c)) or (child.Attachment1 and child.Attachment1:IsDescendantOf(c))) then
                            queue(h.Name, "Web Slinger")
                            wc:Disconnect()
                        end
                    end)
                end
            end
        end)
        for _, c in ipairs(WS:GetChildren()) do
            local sid = c.Name:match("Sentry_(%d+)")
            if sid then
                task.spawn(function()
                    local ok, nm = pcall(Players.GetNameFromUserIdAsync, Players, tonumber(sid))
                    sentryOwners[ok and nm or "Unknown"] = true
                end)
            end
            trackBullet(c); watchDoge(c); trackMissile(c)
        end

        -- body swap: holder and me swap places
        local bsHit, bsPrevH, bsPrevL, bsJustFired = {}, nil, nil, false
        local function hookPotion(char)
            local function hook(pot)
                pot.Activated:Connect(function()
                    bsJustFired = true
                    task.delay(1, function() bsJustFired = false end)
                end)
            end
            local p = char:FindFirstChild("Body Swap Potion")
            if p then hook(p) end
            char.ChildAdded:Connect(function(c) if c.Name == "Body Swap Potion" then hook(c) end end)
        end
        if LPl.Character then hookPotion(LPl.Character) end
        LPl.CharacterAdded:Connect(hookPotion)
        RS.Heartbeat:Connect(function()
            if not enabled() then bsPrevH, bsPrevL = nil, nil; return end
            local me = hrp()
            if me then
                for child in pairs(watchedDoge) do
                    if child.Parent then
                        local user = child.Name:match("^PlayerName_(.+)_Doge$")
                        local part = child:IsA("BasePart") and child or child:FindFirstChildWhichIsA("BasePart", true)
                        if user and part and (part.Position - me.Position).Magnitude <= 5 and tick() - lastDoge >= 2 then
                            lastDoge = tick()
                            queue(user, "Attack Doge")
                        end
                    end
                end
            end
            local h = getHolder("Body Swap Potion")
            if not h then bsPrevH, bsPrevL = nil, nil; return end
            local cd = bsHit[h.Name]
            if cd and tick() - cd < 30 then return end
            local hh3 = h.Character and h.Character:FindFirstChild("HumanoidRootPart")
            if not hh3 or not me then return end
            local cH, cL = hh3.Position, me.Position
            if bsPrevH and bsPrevL and (cH - bsPrevL).Magnitude <= 12 and (cL - bsPrevH).Magnitude <= 12 and not bsJustFired then
                bsHit[h.Name] = tick()
                queue(h.Name, "Body Swap Potion")
