                            end
                        end
                    end
                end
                task.wait(0.25)
            end
        end)

        local function watchPart(part, radius, onHit)
            local done = false
            local function fire() if not done then done = true; onHit() end end
            part.Touched:Connect(function(hit)
                local c = LPl.Character
                if c and hit:IsDescendantOf(c) then fire() end
            end)
            local conn
            conn = RS.Heartbeat:Connect(function()
                if paused() then return end
                if done or not part.Parent then conn:Disconnect(); return end
                local h = hrp()
                if h and (part.Position - h.Position).Magnitude <= radius then fire() end
            end)
        end

        local sentryOwners, hitBullets, watchedDoge = {}, {}, {}
        local lastDoge, lastLaser, lastMedusa, lastPaint, lastBoogie = 0, 0, 0, 0, 0
