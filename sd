function HalfwaySteal.execute()
    if player:GetAttribute("Stealing") or HalfwaySteal.debounce then return end
    HalfwaySteal.debounce = true

    task.spawn(function()
        local startT = tick()
        while tick() - startT < STEAL_DURATION do
            local p = math.clamp((tick() - startT) / STEAL_DURATION, 0, 1)
            updateProgressBar(p); task.wait()
        end
        updateProgressBar(1); task.wait(0.3); updateProgressBar(0)
    end)

    task.spawn(function()
        if PotionEnabled then
            ExecuteAutoPotion()

            local respawned = false
            local conn
            conn = player.CharacterAdded:Connect(function() if _G.SDRX_KILL_semi then return end  respawned = true end)

            HalfwaySteal.activate()

            local waited = 0
            while not respawned and waited < 10 do
                task.wait(0.05); waited = waited + 0.05
            end
            if conn then conn:Disconnect() end

            local hrpWait = 0
            while (not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") or not player.Character:FindFirstChildOfClass("Humanoid")) and hrpWait < 5 do
                task.wait(0.1); hrpWait = hrpWait + 0.1
            end
            while _G.__mwpResetBusy and hrpWait < 8 do
                task.wait(0.1); hrpWait = hrpWait + 0.1
            end
            task.wait(0.3)
        end

        setFFlags()
        HalfwaySteal.SSDoTeleport()
        task.wait(0.1)
        HalfwaySteal.debounce = false
    end)
end

local function checkEnemyBaseOpen()
    local plots = Workspace:FindFirstChild("Plots")
