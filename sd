local function SDRX_plotPos(plot)
    local p
    pcall(function()
        if plot.PrimaryPart then p = plot.PrimaryPart.Position else p = plot:GetPivot().Position end
    end)
    if not p then
        local part = plot:FindFirstChildWhichIsA("BasePart", true)
        if part then p = part.Position end
    end
    return p
end

-- position of the recorded reference plot (b1/b2) that this plot's route is based on, or nil if the plot is on another side
local function SDRX_refPlotPos(pp)
    local plots = Workspace:FindFirstChild("Plots")
    if not plots or not pp then return nil end
    local ref = (pp - BASES.b1.refVec).Magnitude < (pp - BASES.b2.refVec).Magnitude and BASES.b1.refVec or BASES.b2.refVec
    local refPlotPos, bd
    for _, p2 in ipairs(plots:GetChildren()) do
        local q = SDRX_plotPos(p2)
        if q then
            local d = (q - ref).Magnitude
            if not bd or d < bd then bd, refPlotPos = d, q end
        end
    end
    if not refPlotPos or bd > 60 then return nil end
    if math.abs(pp.X - refPlotPos.X) > 30 then return nil end
    return refPlotPos
end

-- how far (along the lane) this plot is from the reference plot whose route was recorded
function SDRX_shiftFor(plot)
    local pp = plot and SDRX_plotPos(plot)
    local refPos = pp and SDRX_refPlotPos(pp)
    if not refPos then return Vector3.new(0, 0, 0) end
    return Vector3.new(0, 0, pp.Z - refPos.Z)
end

-- enemy plots the semi route works on, nearest to your own plot first (so extra slots grow away from your plot)
SDRX_orderedEnemyPlots = function()
    local out = {}
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return out end
    local origin
    for _, plot in ipairs(plots:GetChildren()) do
        local sign = plot:FindFirstChild("PlotSign")
        local sg = sign and sign:FindFirstChild("SurfaceGui")
        local lb = sg and sg:FindFirstChild("Frame") and sg.Frame:FindFirstChild("TextLabel")
        if lb and lb.Text ~= "Empty Base" then
            local owner = lb.Text:gsub("'s [Bb]ase$", ""):gsub("%s+$", "")
            if owner == player.Name or owner == player.DisplayName then origin = SDRX_plotPos(plot) end
        end
    end
    local hrp0 = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    origin = origin or (hrp0 and hrp0.Position) or Vector3.new(0, 0, 0)
    for _, plot in ipairs(plots:GetChildren()) do
        if isEnemyPlot(plot) then
            local pp = SDRX_plotPos(plot)
            if pp and SDRX_refPlotPos(pp) then out[#out + 1] = { plot = plot, d = (pp - origin).Magnitude } end
        end
    end
    table.sort(out, function(a, c) return a.d < c.d end)
    local res = {}
    for i2, e in ipairs(out) do res[i2] = e.plot end
    return res
end
SDRX_plotForGroup = function(g)
    local list = SDRX_orderedEnemyPlots()
    return list[g + 1]
end
SDRX_maxSlots = function()
    return math.min(5 * math.max(1, #SDRX_orderedEnemyPlots()), 60)
end

