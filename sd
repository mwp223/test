    -- ---------------- auto turret (Sammydawg) ----------------
    local seenAt = setmetatable({}, { __mode = "k" })
    local armed = setmetatable({}, { __mode = "k" })
    local cool = setmetatable({}, { __mode = "k" })
    local pin = setmetatable({}, { __mode = "k" })
    local boot = tick()
    local cycleActive = false
    local function charParts()
        local c = LP.Character
        return c, c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
    end
    local function isPlayerRig(inst)
        local par = inst
        while par and par ~= WS do
            if Players:GetPlayerFromCharacter(par) or (par.ClassName == "Model" and par:FindFirstChildOfClass("Humanoid")) then return true end
            par = par.Parent
        end
        return false
    end
    local function isDeploying(target)
        local fp, pinned = {}, false
        for _, d in ipairs(target:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text ~= "" then
                local t = d.Text
                local ev = false
                if t:lower():find("ready", 1, true) then ev = true
                else
                    local num = t:match("^%s*(%d+%.?%d*)%s*[sS]?%s*!*%s*$")
                    if num and (tonumber(num) or 99) <= 10 then ev = true end
                end
                if ev then pinned = true; fp[#fp + 1] = t end
            end
        end
        if not pinned then pin[target] = nil return false end
        local key, now = table.concat(fp, "\1"), tick()
        local p = pin[target]
        if not p or p.key ~= key then pin[target] = { key = key, at = now } return true end
        if now - p.at >= 1.2 then return false end
        return true
    end
    local function targetable(inst)
        if isPlayerRig(inst) then return false end
        if armed[inst] then return true end
        local now = tick()
        local seen = seenAt[inst]
        if not seen then seen = now; seenAt[inst] = now end
        if now - seen >= 12 then armed[inst] = true return true end
        if isDeploying(inst) then return false end
        armed[inst] = true
        return true
    end
    local function weapon()
        local c = LP.Character
        if not c then return nil end
        local bp = LP.Backpack
        return (bp and bp:FindFirstChild("Bat")) or c:FindFirstChild("Bat")
            or (bp and bp:FindFirstChild("Gummy Bear")) or c:FindFirstChild("Gummy Bear")
    end
    local function closestSentry(includeCooled)
        local _, hrp = charParts()
        if not hrp then return nil end
        local best, shortest, now = nil, math.huge, tick()
        for _, inst in ipairs(WS:GetChildren()) do
            local nm = inst.Name
            if nm:find("Sentry", 1, true) and nm ~= "SentryBullet" and (inst.ClassName == "Model" or inst:IsA("BasePart"))
                and (includeCooled or not (cool[inst] and now < cool[inst])) and targetable(inst) then
                local root = inst:IsA("BasePart") and inst or inst:FindFirstChildWhichIsA("BasePart", true)
                if root then
                    local d = (hrp.Position - root.Position).Magnitude
                    if d < shortest then shortest, best = d, inst end
                end
            end
        end
        return best
    end
    local function visuals(target)
        for _, d in ipairs(target:GetDescendants()) do
            if d:IsA("BasePart") and d ~= target then
                d.Transparency = 0.5; d.CanCollide = false; d.CanTouch = false; d.CanQuery = false
            elseif d:IsA("BillboardGui") and d.Name == "SentryLabel" then d:Destroy()
            elseif d:IsA("Decal") or d:IsA("Texture") then d.Transparency = 0.5 end
        end
    end
    local function destroyCycle(sentry)
        if cycleActive then return end
        cycleActive = true
        local t0 = tick()
        while sentry and sentry.Parent and LP:GetAttribute("Stealing") ~= true and tick() - t0 < 6 do
            local c, hrp, hum = charParts()
            if not c or not hrp or not hum then break end
            if isTeleporting or _G.SDRCarpetSpeedOn then break end
            local w = weapon()
            visuals(sentry)
            local cf = CFrame.new(hrp.Position + hrp.CFrame.LookVector * 4, hrp.Position)
            if sentry:IsA("Model") then sentry:PivotTo(cf) elseif sentry:IsA("BasePart") then sentry.CFrame = cf end
            if not w then break end
            if w.Parent ~= c then hum:EquipTool(w) end
            w:Activate()
            task.wait(0.1)
        end
        if sentry and sentry.Parent and tick() - t0 >= 6 then cool[sentry] = tick() + 2.5 end
        cycleActive = false
    end
    task.spawn(function()
        while true do
            task.wait(0.1)
            if not flags.autoturret then continue end
            if tick() - boot < 8 then continue end
            if isTeleporting or _G.SDRCarpetSpeedOn or LP:GetAttribute("Stealing") == true then continue end
            local s = closestSentry()
            if s and weapon() then
                local c, _, hum = charParts()
                local w = weapon()
                if c and hum and w and w.Parent ~= c then pcall(function() hum:EquipTool(w) end) end
                destroyCycle(s)
            end
        end
    end)
end

