    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if MWP_BindingTarget then
        local target = MWP_BindingTarget
        MWP_BindingTarget = nil
        if input.KeyCode == Enum.KeyCode.Escape then
            MWP_ToggleKeybinds[target.name] = nil
            HubConfig.toggleKeybinds[target.name] = nil
            saveHubConfig()
            if target.badge then target.badge.Text = "" end
            return
        end
        MWP_ToggleKeybinds[target.name] = { key = input.KeyCode, fire = target.fire }
        HubConfig.toggleKeybinds[target.name] = input.KeyCode.Name
        saveHubConfig()
        if target.badge then target.badge.Text = "[" .. input.KeyCode.Name .. "]" end
        return
    end
    if processed then return end
    for _, bind in pairs(MWP_ToggleKeybinds) do
        if input.KeyCode == bind.key then
            pcall(bind.fire)
        end
    end
end)

